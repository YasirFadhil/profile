# Security Configuration
# Copy this file to .env and fill in the required values

# FormSpree Form ID (get from formspree.io dashboard)
PUBLIC_FORMSPREE_ID=f/xqajljbq

# Enable security features
ENABLE_CSP=true
ENABLE_RATE_LIMITING=true

# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=3600000

# Contact information (consider not exposing sensitive data)
# Instead of phone number, use contact form
PUBLIC_CONTACT_EMAIL=your-email@example.com
