---
interface Props {
    text: string;
    speed?: number;
    cursorVisible?: boolean;
}

const { text, speed = 100, cursorVisible = true } = Astro.props;
---

<div
    class="typing-container"
    data-text={text}
    data-speed={speed}
    data-cursor={cursorVisible}
    style={`--text-length: ${text.length}`}
>
    <span class="typing-text"></span>
    {cursorVisible && <span class="typing-cursor">|</span>}
</div>

<style>
    .typing-container {
        display: block;
        position: relative;
        width: 100%;
        min-height: 1.5em;
        line-height: 1.5;
    }

    .typing-text {
        display: inline;
        white-space: normal;
        word-break: break-word;
        min-height: 1em;
    }

    .typing-cursor {
        display: inline-block;
        animation: blink 0.7s step-end infinite;
        margin-left: 2px;
    }

    @keyframes blink {
        0%,
        49% {
            opacity: 1;
        }
        50%,
        100% {
            opacity: 0;
        }
    }
</style>

<script>
    function initializeTyping() {
        const containers = document.querySelectorAll(".typing-container");

        containers.forEach((container) => {
            const text = container.getAttribute("data-text") || "";
            const speed = parseInt(
                container.getAttribute("data-speed") || "100",
            );
            const typingText = container.querySelector(".typing-text");

            if (!typingText) return;

            let currentIndex = 0;
            let isDeleting = false;

            const typeCharacter = () => {
                if (!isDeleting) {
                    // Typing phase
                    if (currentIndex < text.length) {
                        typingText.textContent += text[currentIndex];
                        currentIndex++;
                        setTimeout(typeCharacter, speed);
                    } else {
                        // Done typing, wait before deleting
                        isDeleting = true;
                        setTimeout(typeCharacter, 1500);
                    }
                } else {
                    // Deleting phase
                    if (currentIndex > 0) {
                        typingText.textContent = text.substring(
                            0,
                            currentIndex - 1,
                        );
                        currentIndex--;
                        setTimeout(typeCharacter, speed / 2);
                    } else {
                        // Done deleting, restart
                        isDeleting = false;
                        setTimeout(typeCharacter, 500);
                    }
                }
            };

            typeCharacter();
        });
    }

    // Run when DOM is ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeTyping);
    } else {
        initializeTyping();
    }
</script>
