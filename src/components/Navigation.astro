---
const name = "ysirnf";
---

<nav
    class="fixed top-0 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-700/50 z-50"
>
    <div class="max-w-6xl mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
            <h1
                class="text-xl font-bold bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >
                <a href="/">{name}</a>
            </h1>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex space-x-8">
                <a
                    href="/"
                    class="text-slate-300 hover:text-blue-400 transition-colors"
                    >Home</a
                >
                <a
                    href="/about"
                    class="text-slate-300 hover:text-blue-400 transition-colors"
                    >About</a
                >
                <a
                    href="/gallery"
                    class="text-slate-300 hover:text-blue-400 transition-colors"
                    >Gallery</a
                >
                <a
                    href="/#projects"
                    class="text-slate-300 hover:text-blue-400 transition-colors"
                    >Projects</a
                >
            </div>

            <!-- Mobile Menu Button -->
            <button
                id="mobile-menu-btn"
                class="md:hidden text-slate-300 hover:text-blue-400 transition-colors"
            >
                <i class="fas fa-bars text-xl"></i>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div
            id="mobile-menu"
            class="md:hidden hidden absolute top-full left-0 w-full bg-slate-900/95 backdrop-blur-md border-b border-slate-700/50"
        >
            <div class="px-6 py-4 space-y-4">
                <a
                    href="/"
                    class="block text-slate-300 hover:text-blue-400 transition-colors mobile-nav-link"
                    >Home</a
                >
                <a
                    href="/about"
                    class="block text-slate-300 hover:text-blue-400 transition-colors mobile-nav-link"
                    >About</a
                >
                <a
                    href="/gallery"
                    class="block text-slate-300 hover:text-blue-400 transition-colors mobile-nav-link"
                    >Gallery</a
                >
                <a
                    href="/projects"
                    class="block text-slate-300 hover:text-blue-400 transition-colors mobile-nav-link"
                    >Projects</a
                >
            </div>
        </div>
    </div>
</nav>
