---
const name = "ysirnf";

// Get current pathname
const currentPath = new URL(Astro.request.url).pathname;

// Helper function to check if link is active
const isActive = (href: string) => {
    if (href === "/" && currentPath === "/") return true;
    if (href !== "/" && currentPath.startsWith(href)) return true;
    return false;
};
---

<nav
    class="fixed top-0 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-700/50 z-50"
>
    <div class="max-w-6xl mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
            <!-- title -->
            <h1 class="text-xl font-bold nav-animated-gradient">
                <a href="/">{name}</a>
            </h1>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex space-x-8">
                <a
                    href="/"
                    class={`transition-colors ${isActive("/") ? "text-blue-400 font-semibold border-b-2 border-blue-400" : "text-slate-300 hover:text-blue-400"}`}
                    >Home</a
                >
                <a
                    href="/about"
                    class={`transition-colors ${isActive("/about") ? "text-blue-400 font-semibold border-b-2 border-blue-400" : "text-slate-300 hover:text-blue-400"}`}
                    >About</a
                >
                <a
                    href="/gallery"
                    class={`transition-colors ${isActive("/gallery") ? "text-blue-400 font-semibold border-b-2 border-blue-400" : "text-slate-300 hover:text-blue-400"}`}
                    >Gallery</a
                >
                <a
                    href="/projects"
                    class={`transition-colors ${isActive("/projects") ? "text-blue-400 font-semibold border-b-2 border-blue-400" : "text-slate-300 hover:text-blue-400"}`}
                    >Projects</a
                >
            </div>

            <!-- Mobile Menu Button -->
            <button
                id="mobile-menu-btn"
                class="md:hidden text-slate-300 hover:text-blue-400 transition-colors"
            >
                <i class="fas fa-bars text-xl"></i>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div
            id="mobile-menu"
            class="md:hidden hidden absolute top-full left-0 w-full bg-slate-900/95 backdrop-blur-md border-b border-slate-700/50"
        >
            <div class="px-6 py-4 space-y-4">
                <a
                    href="/"
                    class={`block transition-colors mobile-nav-link ${isActive("/") ? "text-blue-400 font-semibold border-l-4 border-blue-400 pl-2" : "text-slate-300 hover:text-blue-400"}`}
                    >Home</a
                >
                <a
                    href="/about"
                    class={`block transition-colors mobile-nav-link ${isActive("/about") ? "text-blue-400 font-semibold border-l-4 border-blue-400 pl-2" : "text-slate-300 hover:text-blue-400"}`}
                    >About</a
                >
                <a
                    href="/gallery"
                    class={`block transition-colors mobile-nav-link ${isActive("/gallery") ? "text-blue-400 font-semibold border-l-4 border-blue-400 pl-2" : "text-slate-300 hover:text-blue-400"}`}
                    >Gallery</a
                >
                <a
                    href="/projects"
                    class={`block transition-colors mobile-nav-link ${isActive("/projects") ? "text-blue-400 font-semibold border-l-4 border-blue-400 pl-2" : "text-slate-300 hover:text-blue-400"}`}
                    >Projects</a
                >
            </div>
        </div>
    </div>
</nav>

<style>
    .nav-animated-gradient {
        background: linear-gradient(90deg, #60a5fa, #a78bfa, #06b6d4, #60a5fa);
        background-size: 300% 300%;
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradientFlow 4s ease infinite;
    }

    @keyframes gradientFlow {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }
</style>
