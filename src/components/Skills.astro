---

---

<section id="skills" class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16 animate-fadeInUp animate-delay-200">
            <h2
                class="text-3xl md:text-4xl font-bold mb-4 bg-linear-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >
                What Can I Do
            </h2>
            <p class="text-slate-300 text-lg max-w-2xl mx-auto">
                Here are some of the things that I can do and working with
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <div
                class="group bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 p-6 rounded-2xl hover:border-blue-400/50 hover:bg-slate-700/50 transition-all duration-300 hover:transform hover:scale-105 hover:shadow-lg hover:shadow-blue-500/10"
            >
                <div class="text-center">
                    <div
                        class="w-16 h-16 bg-linear-to-br from-blue-500 to-violet-500 rounded-2xl mx-auto mb-4 flex items-center justify-center group-hover:shadow-lg group-hover:shadow-blue-500/25 transition-all duration-300 transform group-hover:scale-110"
                    >
                        <i class="fas fa-heart text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-slate-200 mb-2">
                        Vibe Coding
                    </h3>
                    <p class="text-slate-400 text-sm">
                        Prompting an Idea in AI Agent
                    </p>
                </div>
            </div>

            <div
                class="group bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 p-6 rounded-2xl hover:border-violet-400/50 hover:bg-slate-700/50 transition-all duration-300 hover:transform hover:scale-105 hover:shadow-lg hover:shadow-violet-500/10"
            >
                <div class="text-center">
                    <div
                        class="w-16 h-16 bg-linear-to-br from-violet-500 to-pink-500 rounded-2xl mx-auto mb-4 flex items-center justify-center group-hover:shadow-lg group-hover:shadow-violet-500/25 transition-all duration-300 transform group-hover:scale-110"
                    >
                        <i class="fas fa-camera text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-slate-200 mb-2">
                        Phone Photography
                    </h3>
                    <p class="text-slate-400 text-sm">Capturing moments</p>
                </div>
            </div>

            <div
                class="group bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 p-6 rounded-2xl hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all duration-300 hover:transform hover:scale-105 hover:shadow-lg hover:shadow-cyan-500/10"
            >
                <div class="text-center">
                    <div
                        class="w-16 h-16 bg-linear-to-br from-cyan-500 to-blue-500 rounded-2xl mx-auto mb-4 flex items-center justify-center group-hover:shadow-lg group-hover:shadow-cyan-500/25 transition-all duration-300 transform group-hover:scale-110"
                    >
                        <i class="fas fa-palette text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-slate-200 mb-2">
                        Word/Canva
                    </h3>
                    <p class="text-slate-400 text-sm">
                        Design & content creation
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
