---
import { validateContactForm, sanitizeInput } from "../config/security";

const name = "ysirnf";
---

<section id="contact" class="py-20 px-6 gradient-bg-contact">
    <div class="max-w-4xl mx-auto text-center">
        <div class="animate-fadeInUp animate-delay-200">
            <h2
                class="text-3xl md:text-4xl font-bold mb-6 bg-linear-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >
                Let's Connect
            </h2>
            <p class="text-slate-300 text-lg mb-12 max-w-2xl mx-auto">
                I'm always excited to collaborate on new projects or just have a
                chat about technology
            </p>

            <!-- Contact Form -->
            <div class="max-w-2xl mx-auto mb-12">
                <form
                    id="contact-form"
                    class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-8"
                    action="https://formspree.io/f/xqajljbq"
                    method="POST"
                    novalidate
                >
                    <!-- Form status messages -->
                    <div id="form-status" class="mb-6 hidden"></div>

                    <div class="grid md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label
                                for="name"
                                class="block text-slate-300 text-sm font-medium mb-2"
                                >Name <span class="text-red-400">*</span></label
                            >
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                autocomplete="name"
                                minlength="2"
                                maxlength="100"
                                class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-200 focus:border-blue-400 focus:outline-none transition-colors"
                                placeholder="Your Name"
                                aria-describedby="name-error"
                            />
                            <p
                                id="name-error"
                                class="text-red-400 text-xs mt-1 hidden"
                            >
                            </p>
                        </div>
                        <div>
                            <label
                                for="email"
                                class="block text-slate-300 text-sm font-medium mb-2"
                                >Email <span class="text-red-400">*</span
                                ></label
                            >
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                autocomplete="email"
                                maxlength="254"
                                class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-200 focus:border-blue-400 focus:outline-none transition-colors"
                                placeholder="your@email.com"
                                aria-describedby="email-error"
                            />
                            <p
                                id="email-error"
                                class="text-red-400 text-xs mt-1 hidden"
                            >
                            </p>
                        </div>
                    </div>
                    <div class="mb-6">
                        <label
                            for="subject"
                            class="block text-slate-300 text-sm font-medium mb-2"
                            >Subject <span class="text-red-400">*</span></label
                        >
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            required
                            minlength="3"
                            maxlength="200"
                            class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-200 focus:border-blue-400 focus:outline-none transition-colors"
                            placeholder="What's this about?"
                            aria-describedby="subject-error"
                        />
                        <p
                            id="subject-error"
                            class="text-red-400 text-xs mt-1 hidden"
                        >
                        </p>
                    </div>
                    <div class="mb-6">
                        <label
                            for="message"
                            class="block text-slate-300 text-sm font-medium mb-2"
                            >Message <span class="text-red-400">*</span></label
                        >
                        <textarea
                            id="message"
                            name="message"
                            rows="4"
                            required
                            minlength="10"
                            maxlength="5000"
                            class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-200 focus:border-blue-400 focus:outline-none transition-colors resize-none"
                            placeholder="Tell me about your project or just say hi!"
                            aria-describedby="message-error"></textarea>
                        <p
                            id="message-error"
                            class="text-red-400 text-xs mt-1 hidden"
                        >
                        </p>
                    </div>
                    <button
                        type="submit"
                        id="submit-btn"
                        class="w-full bg-linear-to-r from-blue-500 to-violet-500 text-white py-3 rounded-lg font-medium hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300 hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <i class="fas fa-paper-plane mr-2"></i>
                        <span id="submit-text">Send Message</span>
                    </button>
                    <p class="text-slate-400 text-xs mt-4">
                        🔒 Your data is secure and will never be shared
                    </p>
                </form>
            </div>

            <!-- Social Media Links -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
                <a
                    href="https://instagram.com/ysirnf_"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-pink-400/50 transition-all duration-300 hover:scale-105"
                >
                    <div class="text-2xl mb-2">
                        <i class="fab fa-instagram text-pink-400"></i>
                    </div>
                    <span
                        class="text-slate-300 group-hover:text-pink-400 transition-colors"
                        >Instagram</span
                    >
                </a>

                <a
                    href="https://x.com/ysirnf_"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-blue-400/50 transition-all duration-300 hover:scale-105"
                >
                    <div class="text-2xl mb-2">
                        <i class="fab fa-x-twitter text-blue-400"></i>
                    </div>
                    <span
                        class="text-slate-300 group-hover:text-blue-400 transition-colors"
                        >X</span
                    >
                </a>

                <a
                    href="https://wa.me/6287712336358"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-green-500/50 transition-all duration-300 hover:scale-105"
                >
                    <div class="text-2xl mb-2">
                        <i class="fab fa-whatsapp text-green-500"></i>
                    </div>
                    <span
                        class="text-slate-300 group-hover:text-green-600 transition-colors"
                        >WhatsApp</span
                    >
                </a>

                <a
                    href="https://github.com/YasirFadhil"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-slate-50/50 transition-all duration-300 hover:scale-105"
                >
                    <div class="text-2xl mb-2">
                        <i class="fab fa-github text-slate-50"></i>
                    </div>
                    <span
                        class="text-slate-300 group-hover:text-slate-400 transition-colors"
                        >GitHub</span
                    >
                </a>
            </div>
        </div>
    </div>
</section>

<script
    define:vars={{ RATE_LIMIT_CONFIG: { maxRequests: 5, windowMs: 3600000 } }}
>
    // Form validation and security implementation
    const form = document.getElementById("contact-form");
    const submitBtn = document.getElementById("submit-btn");
    const formStatus = document.getElementById("form-status");
    const submitText = document.getElementById("submit-text");

    // Rate limiting
    let formSubmissions = [];
    const MAX_REQUESTS = 5;
    const WINDOW_MS = 60 * 60 * 1000; // 1 hour

    // Validation rules
    const validationRules = {
        name: {
            minLength: 2,
            maxLength: 100,
            pattern: /^[a-zA-Z\s'-]+$/,
            message:
                "Name should contain only letters, spaces, hyphens, and apostrophes",
        },
        email: {
            minLength: 5,
            maxLength: 254,
            pattern: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
            message: "Please enter a valid email address",
        },
        subject: {
            minLength: 3,
            maxLength: 200,
            pattern: /^[a-zA-Z0-9\s.,!?'-]+$/,
            message: "Subject contains invalid characters",
        },
        message: {
            minLength: 10,
            maxLength: 5000,
            message: "Message must be between 10 and 5000 characters",
        },
    };

    // Sanitize input
    function sanitizeInput(input) {
        return input.replace(/[<>]/g, "").trim().slice(0, 5000);
    }

    // Validate individual field
    function validateField(fieldName, value) {
        const rule = validationRules[fieldName];
        if (!rule) return { valid: true };

        const sanitized = sanitizeInput(value);

        if (
            sanitized.length < rule.minLength ||
            sanitized.length > rule.maxLength
        ) {
            return { valid: false, message: rule.message };
        }

        if (!rule.pattern.test(sanitized)) {
            return { valid: false, message: rule.message };
        }

        return { valid: true };
    }

    // Show error message
    function showError(fieldName, message) {
        const errorElement = document.getElementById(`${fieldName}-error`);
        const field = document.getElementById(fieldName);
        if (errorElement) {
            errorElement.textContent = message;
            errorElement.classList.remove("hidden");
            field.classList.add("border-red-500", "bg-red-500/10");
        }
    }

    // Clear error message
    function clearError(fieldName) {
        const errorElement = document.getElementById(`${fieldName}-error`);
        const field = document.getElementById(fieldName);
        if (errorElement) {
            errorElement.classList.add("hidden");
            field.classList.remove("border-red-500", "bg-red-500/10");
        }
    }

    // Show form status message
    function showStatus(message, type = "error") {
        formStatus.textContent = message;
        formStatus.className = `p-4 rounded-lg ${
            type === "error"
                ? "bg-red-500/20 text-red-400 border border-red-500/50"
                : "bg-green-500/20 text-green-400 border border-green-500/50"
        }`;
        formStatus.classList.remove("hidden");
    }

    // Clear form status
    function clearStatus() {
        formStatus.classList.add("hidden");
    }

    // Check rate limit
    function checkRateLimit() {
        const now = Date.now();
        formSubmissions = formSubmissions.filter(
            (time) => now - time < WINDOW_MS,
        );

        if (formSubmissions.length >= MAX_REQUESTS) {
            return false;
        }

        formSubmissions.push(now);
        return true;
    }

    // Real-time validation on input
    ["name", "email", "subject", "message"].forEach((fieldName) => {
        const field = document.getElementById(fieldName);
        if (field) {
            field.addEventListener("blur", () => {
                const validation = validateField(fieldName, field.value);
                if (validation.valid) {
                    clearError(fieldName);
                } else {
                    showError(fieldName, validation.message);
                }
            });

            field.addEventListener("input", () => {
                // Clear error on input if field is valid
                if (
                    field.value &&
                    validateField(fieldName, field.value).valid
                ) {
                    clearError(fieldName);
                }
            });
        }
    });

    // Form submission
    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearStatus();

        // Rate limit check
        if (!checkRateLimit()) {
            showStatus("Too many requests. Please try again later.", "error");
            return;
        }

        // Validate all fields
        const formData = {
            name: document.getElementById("name").value,
            email: document.getElementById("email").value,
            subject: document.getElementById("subject").value,
            message: document.getElementById("message").value,
        };

        let isValid = true;
        for (const [fieldName, value] of Object.entries(formData)) {
            const validation = validateField(fieldName, value);
            if (!validation.valid) {
                showError(fieldName, validation.message);
                isValid = false;
            }
        }

        if (!isValid) {
            showStatus("Please fix the errors above", "error");
            return;
        }

        // Disable submit button and show loading state
        submitBtn.disabled = true;
        submitText.textContent = "Sending...";

        // Submit form after validation
        try {
            // The form will submit to FormSpree via standard form submission
            form.submit();
        } catch (error) {
            showStatus("An error occurred. Please try again.", "error");
            submitBtn.disabled = false;
            submitText.textContent = "Send Message";
        }
    });
</script>
