---
const name = "ysirnf";
---

<section id="contact" class="py-20 px-6 bg-slate-800/30">
    <div class="max-w-4xl mx-auto text-center">
        <div class="animate-fadeInUp animate-delay-200">
            <h2
                class="text-3xl md:text-4xl font-bold mb-6 bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >
                Let's Connect
            </h2>
            <p class="text-slate-300 text-lg mb-12 max-w-2xl mx-auto">
                I'm always excited to collaborate on new projects or just have a
                chat about technology
            </p>

            <!-- Contact Form -->
            <div class="max-w-2xl mx-auto mb-12">
                <form
                    id="contact-form"
                    class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-8"
                    action="https://formspree.io/f/xqajljbq"
                    method="POST"
                >
                    <div class="grid md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label
                                for="name"
                                class="block text-slate-300 text-sm font-medium mb-2"
                                >Name</label
                            >
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-200 focus:border-blue-400 focus:outline-none transition-colors"
                                placeholder="Your Name"
                            />
                        </div>
                        <div>
                            <label
                                for="email"
                                class="block text-slate-300 text-sm font-medium mb-2"
                                >Email</label
                            >
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-200 focus:border-blue-400 focus:outline-none transition-colors"
                                placeholder="your@email.com"
                            />
                        </div>
                    </div>
                    <div class="mb-6">
                        <label
                            for="subject"
                            class="block text-slate-300 text-sm font-medium mb-2"
                            >Subject</label
                        >
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            required
                            class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-200 focus:border-blue-400 focus:outline-none transition-colors"
                            placeholder="What's this about?"
                        />
                    </div>
                    <div class="mb-6">
                        <label
                            for="message"
                            class="block text-slate-300 text-sm font-medium mb-2"
                            >Message</label
                        >
                        <textarea
                            id="message"
                            name="message"
                            rows="4"
                            required
                            class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-200 focus:border-blue-400 focus:outline-none transition-colors resize-none"
                            placeholder="Tell me about your project or just say hi!"
                        ></textarea>
                    </div>
                    <button
                        type="submit"
                        class="w-full bg-gradient-to-r from-blue-500 to-violet-500 text-white py-3 rounded-lg font-medium hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300 hover:scale-105"
                    >
                        <i class="fas fa-paper-plane mr-2"></i>
                        Send Message
                    </button>
                </form>
            </div>

            <!-- Social Media Links -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
                <a
                    href="https://instagram.com/ysirnf_"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-pink-400/50 transition-all duration-300 hover:scale-105"
                >
                    <div class="text-2xl mb-2">
                        <i class="fab fa-instagram text-pink-400"></i>
                    </div>
                    <span
                        class="text-slate-300 group-hover:text-pink-400 transition-colors"
                        >Instagram</span
                    >
                </a>

                <a
                    href="https://x.com/ysirnf_"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-blue-400/50 transition-all duration-300 hover:scale-105"
                >
                    <div class="text-2xl mb-2">
                        <i class="fab fa-x-twitter text-blue-400"></i>
                    </div>
                    <span
                        class="text-slate-300 group-hover:text-blue-400 transition-colors"
                        >X</span
                    >
                </a>

                <a
                    href="https://wa.me/6287712336358"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-orange-400/50 transition-all duration-300 hover:scale-105"
                >
                    <div class="text-2xl mb-2">
                        <i class="fab fa-whatsapp text-green-500"></i>
                    </div>
                    <span
                        class="text-slate-300 group-hover:text-green-600 transition-colors"
                        >WhatsApp</span
                    >
                </a>

                <a
                    href="https://github.com/YasirFadhil"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-green-400/50 transition-all duration-300 hover:scale-105"
                >
                    <div class="text-2xl mb-2">
                        <i class="fab fa-github text-slate-50"></i>
                    </div>
                    <span
                        class="text-slate-300 group-hover:text-slate-400 transition-colors"
                        >GitHub</span
                    >
                </a>
            </div>
        </div>
    </div>
</section>
