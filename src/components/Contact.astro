---
const email = "yasirfadhil46@gmail.com";
const whatsapp = "https://wa.me/6287712336358";
const instagram = "https://instagram.com/ysirnf_";
const tiktok = "https://www.tiktok.com/@ysirnf_";
const xProfile = "https://x.com/ysirnf_";
const github = "https://github.com/YasirFadhil";
const name = "ysirnf";
---

<section id="contact" class="py-20 px-6 gradient-bg-contact">
    <div class="max-w-4xl mx-auto text-center">
        <div class="animate-fadeInUp animate-delay-200">
            <h2
                class="text-3xl md:text-4xl font-bold mb-6 bg-linear-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >
                Let's Connect
            </h2>

            <p class="text-slate-300 text-lg mb-8 max-w-2xl mx-auto">
                I'm always open to collaborating on projects, answering
                questions, or just having a friendly chat about technology. Pick
                whichever way works best for you — email, social, or a quick
                message on WhatsApp.
            </p>

            <div class="max-w-2xl mx-auto mb-10 grid sm:grid-cols-2 gap-6">
                <div
                    class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 text-left"
                >
                    <h3 class="text-xl font-semibold text-slate-100 mb-2">
                        Email
                    </h3>
                    <p class="text-slate-300 mb-4">
                        Send me a message and I'll reply as soon as I can.
                    </p>
                    <a
                        href={`mailto:${email}`}
                        class="inline-block bg-linear-to-r from-blue-500 to-violet-500 text-white py-3 px-5 rounded-lg font-medium hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300"
                    >
                        Mail Me
                    </a>
                </div>

                <div
                    class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 text-left"
                >
                    <h3 class="text-xl font-semibold text-slate-100 mb-2">
                        Quick Message
                    </h3>
                    <p class="text-slate-300 mb-4">
                        Want a faster reply or prefer chat apps? Use WhatsApp
                        for a quick message.
                    </p>
                    <a
                        href={whatsapp}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block bg-green-500 text-white py-3 px-5 rounded-lg font-medium hover:shadow-lg hover:shadow-green-500/25 transition-all duration-300"
                    >
                        Message on WhatsApp
                    </a>
                </div>
            </div>

            <div class="max-w-2xl mx-auto mb-6">
                <h4 class="text-lg text-slate-200 font-medium mb-4">
                    Find me on
                </h4>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                    <a
                        href={instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-pink-400/50 transition-all duration-300 hover:scale-105"
                        aria-label="Instagram"
                    >
                        <div class="text-2xl mb-2">
                            <i
                                class="fab fa-instagram text-pink-400"
                                aria-hidden="true"></i>
                        </div>
                        <span
                            class="text-slate-300 group-hover:text-pink-400 transition-colors"
                            >Instagram</span
                        >
                    </a>

                    <a
                        href={xProfile}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-blue-400/50 transition-all duration-300 hover:scale-105"
                        aria-label="X"
                    >
                        <div class="text-2xl mb-2">
                            <i
                                class="fab fa-x-twitter text-blue-400"
                                aria-hidden="true"></i>
                        </div>
                        <span
                            class="text-slate-300 group-hover:text-blue-400 transition-colors"
                            >X</span
                        >
                    </a>

                    <a
                        href={tiktok}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-green-500/50 transition-all duration-300 hover:scale-105"
                        aria-label="TikTok"
                    >
                        <div class="text-2xl mb-2">
                            <i
                                class="fab fa-tiktok text-pink-200"
                                aria-hidden="true"></i>
                        </div>
                        <span
                            class="text-slate-300 group-hover:text-pink-200 transition-colors"
                            >TikTok</span
                        >
                    </a>

                    <a
                        href={github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-xl hover:border-slate-50/50 transition-all duration-300 hover:scale-105"
                        aria-label="GitHub"
                    >
                        <div class="text-2xl mb-2">
                            <i
                                class="fab fa-github text-slate-50"
                                aria-hidden="true"></i>
                        </div>
                        <span
                            class="text-slate-300 group-hover:text-slate-400 transition-colors"
                            >GitHub</span
                        >
                    </a>
                </div>
            </div>

            <!-- <p class="text-xs text-slate-400 mt-4">
                If you'd rather not use links, you can copy this email address:
                <code class="ml-1 text-slate-200">{email}</code>
            </p> -->

            <p class="text-xs text-slate-400 mt-2">
                Thank you — looking forward to hearing from you!
            </p>
        </div>
    </div>
</section>
