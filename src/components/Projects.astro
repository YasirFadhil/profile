---
const { limit } = Astro.props;

const projects = [
    {
        title: "Health Website",
        description: "Website for health information about nutrition.",
        link: "https://4sehat5sempurna.vercel.app",
        repo: "https://github.com/yasirfadhil",
        icon: "fas fa-laptop-code text-blue-400 text-xl",
        tags: ["HTML", "Tailwind", "JavaScript"],
        external: true,
    },
    {
        title: "Cloud Storage Website",
        description: "Website for storing and sharing files.",
        link: "https://mycloudy.up.railway.app",
        repo: "https://github.com/yasirfadhil/person",
        icon: "fas fa-cloud fas text-blue-400 text-xl",
        tags: ["HTML", "Tailwind", "JavaScript"],
        external: true,
    },
    {
        title: "Historical Website",
        description:
            "Website for historical information about Netherlands and Japan colonialism in Indonesia until Independence.",
        link: "https://sejarahindo.vercel.app",
        repo: "https://github.com/yasirfadhil/nyobo",
        icon: "fas fa-laptop-code text-blue-400 text-xl",
        tags: ["HTML", "CSS", "JavaScript"],
        external: true,
    },
    {
        title: "Photography Gallery",
        description:
            "Showcase of my mobile photography work and creative shots.",
        link: "/gallery",
        repo: null,
        icon: "fas fa-camera text-violet-400 text-xl",
        tags: ["Photography", "Creative"],
        external: false,
    },
    {
        title: "Network Projects",
        description: "Network engineering projects from my vocational studies.",
        link: null,
        repo: null,
        icon: "fas fa-network-wired text-cyan-400 text-xl",
        tags: ["Networking", "Infrastructure"],
        external: false,
    },
];

const list = typeof limit === "number" ? projects.slice(0, limit) : projects;
const few = list.length < 3;
---

<section id="projects" class="py-20 px-6 bg-slate-800/30">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16 animate-fadeInUp animate-delay-200">
            <h2
                class="text-3xl md:text-4xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >
                My Projects
            </h2>
            <p class="text-slate-300 text-lg max-w-2xl mx-auto">
                Here are some projects I've been working on
            </p>
        </div>

        <!-- When there are fewer than 3 items, center them with a flex container.
         Otherwise use a responsive grid that fills the row. -->
        {
            few ? (
                <div class="flex flex-wrap justify-center gap-6">
                    {list.map((project) => (
                        <article class="w-full max-w-sm group bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 rounded-2xl overflow-hidden hover:border-blue-400/50 hover:bg-slate-700/50 transition-all duration-300">
                            <div class="p-6">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-xl font-semibold text-slate-200">
                                        {project.title}
                                    </h3>
                                    <i class={project.icon} />
                                </div>

                                <p class="text-slate-400 text-sm mb-4">
                                    {project.description}
                                </p>

                                <div class="flex flex-wrap gap-2 mb-4">
                                    {project.tags.map((tag) => (
                                        <span class="px-2 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-full">
                                            {tag}
                                        </span>
                                    ))}
                                </div>

                                <div class="flex gap-3">
                                    {project.link ? (
                                        project.external ? (
                                            <a
                                                href={project.link}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="text-blue-400 hover:text-blue-300 transition-colors"
                                            >
                                                <i class="fas fa-external-link-alt" />
                                            </a>
                                        ) : (
                                            <a
                                                href={project.link}
                                                class="text-blue-400 hover:text-blue-300 transition-colors"
                                            >
                                                <i class="fas fa-external-link-alt" />
                                            </a>
                                        )
                                    ) : null}

                                    {project.repo ? (
                                        <a
                                            href={project.repo}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="text-slate-400 hover:text-slate-300 transition-colors"
                                        >
                                            <i class="fab fa-github" />
                                        </a>
                                    ) : null}

                                    {!project.link && !project.repo ? (
                                        <span class="text-slate-500 text-sm">
                                            In Progress
                                        </span>
                                    ) : null}
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            ) : (
                <div
                    class="grid gap-6"
                    style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));"
                >
                    {list.map((project) => (
                        <article class="group bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 rounded-2xl overflow-hidden hover:border-blue-400/50 hover:bg-slate-700/50 transition-all duration-300">
                            <div class="p-6">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-xl font-semibold text-slate-200">
                                        {project.title}
                                    </h3>
                                    <i class={project.icon} />
                                </div>

                                <p class="text-slate-400 text-sm mb-4">
                                    {project.description}
                                </p>

                                <div class="flex flex-wrap gap-2 mb-4">
                                    {project.tags.map((tag) => (
                                        <span class="px-2 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-full">
                                            {tag}
                                        </span>
                                    ))}
                                </div>

                                <div class="flex gap-3">
                                    {project.link ? (
                                        project.external ? (
                                            <a
                                                href={project.link}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="text-blue-400 hover:text-blue-300 transition-colors"
                                            >
                                                <i class="fas fa-external-link-alt" />
                                            </a>
                                        ) : (
                                            <a
                                                href={project.link}
                                                class="text-blue-400 hover:text-blue-300 transition-colors"
                                            >
                                                <i class="fas fa-external-link-alt" />
                                            </a>
                                        )
                                    ) : null}

                                    {project.repo ? (
                                        <a
                                            href={project.repo}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="text-slate-400 hover:text-slate-300 transition-colors"
                                        >
                                            <i class="fab fa-github" />
                                        </a>
                                    ) : null}

                                    {!project.link && !project.repo ? (
                                        <span class="text-slate-500 text-sm">
                                            In Progress
                                        </span>
                                    ) : null}
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            )
        }
    </div>
</section>
