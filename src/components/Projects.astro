---
---

<section id="projects" class="py-20 px-6 bg-slate-800/30">
    <div class="max-w-6xl mx-auto">
        <div
            class="text-center mb-16 animate-fadeInUp animate-delay-200"
        >
            <h2
                class="text-3xl md:text-4xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >
                My Projects
            </h2>
            <p class="text-slate-300 text-lg max-w-2xl mx-auto">
                Here are some projects I've been working on
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div
                class="group bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 rounded-2xl overflow-hidden hover:border-blue-400/50 hover:bg-slate-700/50 transition-all duration-300"
            >
                <div class="p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3
                            class="text-xl font-semibold text-slate-200"
                        >
                            Health Website
                        </h3>
                        <i
                            class="fas fa-laptop-code text-blue-400 text-xl"
                        ></i>
                    </div>
                    <p class="text-slate-400 text-sm mb-4">
                        Website for a health information about
                        nutrition.
                    </p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span
                            class="px-2 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-full"
                            >HTML</span
                        >
                        <span
                            class="px-2 py-1 bg-violet-500/20 text-violet-300 text-xs rounded-full"
                            >Tailwind</span
                        >
                        <span
                            class="px-2 py-1 bg-green-500/20 text-green-300 text-xs rounded-full"
                            >JavaScript</span
                        >
                    </div>
                    <div class="flex gap-3">
                        <a
                            href="https://4sehat5sempurna.vercel.app"
                            target="_blank"
                            class="text-blue-400 hover:text-blue-300 transition-colors"
                        >
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                        <a
                            href="https://github.com/yasirfadhil"
                            target="_blank"
                            class="text-slate-400 hover:text-slate-300 transition-colors"
                        >
                            <i class="fab fa-github"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div
                class="group bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 rounded-2xl overflow-hidden hover:border-violet-400/50 hover:bg-slate-700/50 transition-all duration-300"
            >
                <div class="p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3
                            class="text-xl font-semibold text-slate-200"
                        >
                            Photography Gallery
                        </h3>
                        <i class="fas fa-camera text-violet-400 text-xl"
                        ></i>
                    </div>
                    <p class="text-slate-400 text-sm mb-4">
                        Showcase of my mobile photography work and
                        creative shots
                    </p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span
                            class="px-2 py-1 bg-pink-500/20 text-pink-300 text-xs rounded-full"
                            >Photography</span
                        >
                        <span
                            class="px-2 py-1 bg-purple-500/20 text-purple-300 text-xs rounded-full"
                            >Creative</span
                        >
                    </div>
                    <div class="flex gap-3">
                        <a
                            href="/gallery"
                            class="text-blue-400 hover:text-blue-300 transition-colors"
                        >
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div
                class="group bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 rounded-2xl overflow-hidden hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all duration-300"
            >
                <div class="p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3
                            class="text-xl font-semibold text-slate-200"
                        >
                            Network Projects
                        </h3>
                        <i
                            class="fas fa-network-wired text-cyan-400 text-xl"
                        ></i>
                    </div>
                    <p class="text-slate-400 text-sm mb-4">
                        Network engineering projects from my vocational
                        studies
                    </p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span
                            class="px-2 py-1 bg-cyan-500/20 text-cyan-300 text-xs rounded-full"
                            >Networking</span
                        >
                        <span
                            class="px-2 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-full"
                            >Infrastructure</span
                        >
                    </div>
                    <div class="flex gap-3">
                        <span class="text-slate-500 text-sm"
                            >In Progress</span
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
