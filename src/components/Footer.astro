---
const name = "yasirfadhil";
---

<div class="max-w-4xl mx-auto text-center py-10 px-6">
    <div class="border-t border-slate-700/50 pt-8">
        <p class="text-slate-400 text-sm">
            © {new Date().getFullYear()}
            {name}
        </p>
        <p class="text-slate-500 text-xs mt-2">
            Crafted with <i class="fas fa-heart"></i> from Klaten, Indonesia
        </p>
    </div>
</div>
