---
interface Props {
    texts: string[];
    speed?: number;
    cursorVisible?: boolean;
}

const { texts, speed = 100, cursorVisible = true } = Astro.props;
---

<div
    class="typing-multi-container"
    data-texts={JSON.stringify(texts)}
    data-speed={speed}
    data-cursor={cursorVisible}
>
    <span class="typing-multi-text"></span>{
        cursorVisible && <span class="typing-multi-cursor" />
    }
</div>

<style>
    .typing-multi-container {
        display: inline-block;
        position: relative;
        width: 100%;
        padding-top: 1em;
        min-height: 4.7em;
        line-height: 1.5;
    }

    .typing-multi-text {
        display: inline;
        white-space: normal;
        word-break: break-word;
    }

    .typing-multi-cursor {
        display: inline-block;
        animation: blink 0.7s step-end infinite;
        margin-left: 2px;
        width: 2px;
        height: 1em;
        background-color: currentColor;
        vertical-align: text-bottom;
    }

    @keyframes blink {
        0%,
        49% {
            opacity: 1;
        }
        50%,
        100% {
            opacity: 0;
        }
    }
</style>

<script>
    interface TypingState {
        currentTextIndex: number;
        currentIndex: number;
        isDeleting: boolean;
        isRunning: boolean;
        timeoutId: NodeJS.Timeout | null;
    }

    // Map to track typing state for each container
    const typingStates = new WeakMap<Element, TypingState>();

    function getTypingState(container: Element): TypingState {
        if (!typingStates.has(container)) {
            typingStates.set(container, {
                currentTextIndex: 0,
                currentIndex: 0,
                isDeleting: false,
                isRunning: false,
                timeoutId: null,
            });
        }
        return typingStates.get(container)!;
    }

    function initializeMultiTyping(): void {
        const containers = document.querySelectorAll(".typing-multi-container");

        containers.forEach((container: Element) => {
            const state = getTypingState(container);

            // Cancel any existing timeout
            if (state.timeoutId) {
                clearTimeout(state.timeoutId);
            }

            const textsJson = container.getAttribute("data-texts") || "[]";
            const parsedTexts: string[] = JSON.parse(textsJson);
            const parsedSpeed = parseInt(
                container.getAttribute("data-speed") || "100",
            );
            const typingText = container.querySelector(
                ".typing-multi-text",
            ) as HTMLElement | null;

            if (!typingText || parsedTexts.length === 0) return;

            // Reset state
            state.currentTextIndex = 0;
            state.currentIndex = 0;
            state.isDeleting = false;
            state.isRunning = true;
            typingText.textContent = "";

            const typeCharacter = (): void => {
                const text = parsedTexts[state.currentTextIndex];

                if (!state.isDeleting) {
                    // Typing phase
                    if (state.currentIndex < text.length) {
                        if (typingText) {
                            typingText.textContent = text.substring(
                                0,
                                state.currentIndex + 1,
                            );
                        }
                        state.currentIndex++;
                        state.timeoutId = setTimeout(
                            typeCharacter,
                            parsedSpeed,
                        );
                    } else {
                        // Done typing, wait before deleting
                        state.isDeleting = true;
                        state.timeoutId = setTimeout(typeCharacter, 2000);
                    }
                } else {
                    // Deleting phase
                    if (state.currentIndex > 0) {
                        if (typingText) {
                            typingText.textContent = text.substring(
                                0,
                                state.currentIndex - 1,
                            );
                        }
                        state.currentIndex--;
                        state.timeoutId = setTimeout(
                            typeCharacter,
                            parsedSpeed / 2,
                        );
                    } else {
                        // Done deleting, move to next text
                        state.currentTextIndex =
                            (state.currentTextIndex + 1) % parsedTexts.length;
                        state.isDeleting = false;
                        state.timeoutId = setTimeout(typeCharacter, 500);
                    }
                }
            };

            typeCharacter();
        });
    }

    // Initialize on page load
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeMultiTyping);
    } else {
        initializeMultiTyping();
    }

    // Re-initialize after ViewTransitions
    document.addEventListener("astro:after-swap", initializeMultiTyping);
</script>
