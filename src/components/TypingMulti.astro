---
interface Props {
    texts: string[];
    speed?: number;
    cursorVisible?: boolean;
}

const { texts, speed = 100, cursorVisible = true } = Astro.props;
---

<div
    class="typing-multi-container"
    data-texts={JSON.stringify(texts)}
    data-speed={speed}
    data-cursor={cursorVisible}
>
    <span class="typing-multi-text"></span>{
        cursorVisible && <span class="typing-multi-cursor" />
    }
</div>

<style>
    .typing-multi-container {
        display: inline-block;
        position: relative;
        width: 100%;
        min-height: 5em;
        line-height: 1.5;
    }

    .typing-multi-text {
        display: inline;
        white-space: normal;
        word-break: break-word;
    }

    .typing-multi-cursor {
        display: inline-block;
        animation: blink 0.7s step-end infinite;
        margin-left: 2px;
        width: 2px;
        height: 1em;
        background-color: currentColor;
        vertical-align: text-bottom;
    }

    @keyframes blink {
        0%,
        49% {
            opacity: 1;
        }
        50%,
        100% {
            opacity: 0;
        }
    }
</style>

<script>
    function initializeMultiTyping() {
        const containers = document.querySelectorAll(".typing-multi-container");

        containers.forEach((container) => {
            const textsJson = container.getAttribute("data-texts") || "[]";
            const texts = JSON.parse(textsJson);
            const speed = parseInt(
                container.getAttribute("data-speed") || "100",
            );
            const typingText = container.querySelector(".typing-multi-text");

            if (!typingText || texts.length === 0) return;

            let currentTextIndex = 0;
            let currentIndex = 0;
            let isDeleting = false;
            const currentText = texts[currentTextIndex];

            const typeCharacter = () => {
                const text = texts[currentTextIndex];

                if (!isDeleting) {
                    // Typing phase
                    if (currentIndex < text.length) {
                        typingText.textContent += text[currentIndex];
                        currentIndex++;
                        setTimeout(typeCharacter, speed);
                    } else {
                        // Done typing, wait before deleting
                        isDeleting = true;
                        setTimeout(typeCharacter, 2000);
                    }
                } else {
                    // Deleting phase
                    if (currentIndex > 0) {
                        typingText.textContent = text.substring(
                            0,
                            currentIndex - 1,
                        );
                        currentIndex--;
                        setTimeout(typeCharacter, speed / 2);
                    } else {
                        // Done deleting, move to next text
                        currentTextIndex =
                            (currentTextIndex + 1) % texts.length;
                        isDeleting = false;
                        setTimeout(typeCharacter, 500);
                    }
                }
            };

            typeCharacter();
        });
    }

    // Run when DOM is ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeMultiTyping);
    } else {
        initializeMultiTyping();
    }
</script>
