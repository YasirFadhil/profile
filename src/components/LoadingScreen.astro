---
// LoadingScreen.astro
// Shows a loading screen only on initial page load, not on navigation
---

<div id="loading-screen" class="loading-screen">
    <div class="loading-container">
        <div class="logo-container">
            <div class="glow-orb"></div>
            <span class="logo-text">ysirnf</span>
        </div>
        <div class="loading-bar-container">
            <div class="loading-bar"></div>
        </div>
        <p class="loading-text">Loading...</p>
    </div>
</div>

<style>
    .loading-screen {
        position: fixed;
        inset: 0;
        background: linear-gradient(
            135deg,
            #0f172a 0%,
            #1e293b 50%,
            #0f172a 100%
        );
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 1;
        transition: opacity 0.6s ease-out;
    }

    .loading-screen.fade-out {
        opacity: 0;
        pointer-events: none;
    }

    .loading-container {
        text-align: center;
    }

    .logo-container {
        position: relative;
        margin-bottom: 3rem;
    }

    .glow-orb {
        position: absolute;
        inset: 50%;
        transform: translate(-50%, -50%);
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border-radius: 50%;
        filter: blur(30px);
        animation: pulse-glow 2s ease-in-out infinite;
    }

    .logo-text {
        position: relative;
        display: inline-block;
        font-size: 2.5rem;
        font-weight: bold;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: 0.05em;
    }

    .loading-bar-container {
        width: 200px;
        height: 3px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
        margin: 2rem auto;
        overflow: hidden;
    }

    .loading-bar {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6, #3b82f6);
        border-radius: 2px;
        animation: loading-progress 1.5s ease-in-out infinite;
    }

    .loading-text {
        font-size: 0.875rem;
        color: #94a3b8;
        letter-spacing: 0.1em;
        animation: fade-pulse 1.5s ease-in-out infinite;
    }

    @keyframes pulse-glow {
        0%,
        100% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.6;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.1);
            opacity: 0.4;
        }
    }

    @keyframes loading-progress {
        0% {
            width: 0%;
            transform: translateX(-100%);
        }
        50% {
            width: 100%;
            transform: translateX(100%);
        }
        100% {
            width: 0%;
            transform: translateX(100%);
        }
    }

    @keyframes fade-pulse {
        0%,
        100% {
            opacity: 0.6;
        }
        50% {
            opacity: 1;
        }
    }
</style>

<script>
    declare global {
        interface Window {
            __loadingScreenShown?: boolean;
        }
    }

    function hideLoadingScreen(): void {
        const loadingScreen = document.getElementById("loading-screen");
        if (loadingScreen && !loadingScreen.classList.contains("fade-out")) {
            loadingScreen.classList.add("fade-out");
            setTimeout(() => {
                if (loadingScreen && loadingScreen.parentNode) {
                    loadingScreen.remove();
                }
            }, 600);
        }
    }

    function initLoadingScreen(): void {
        // Only show loading screen on initial page load, not on navigation
        if (window.__loadingScreenShown) {
            hideLoadingScreen();
            return;
        }

        const loadingScreen = document.getElementById("loading-screen");
        if (!loadingScreen) return;

        // Wait for all resources to load
        // Minimum 1.2 seconds
        const minLoadTime = 1200;
        const startTime = Date.now();

        const checkAndHide = (): void => {
            const elapsed = Date.now() - startTime;
            if (elapsed >= minLoadTime) {
                hideLoadingScreen();
                window.__loadingScreenShown = true;
            } else {
                setTimeout(checkAndHide, 100);
            }
        };

        // If page is already fully loaded
        if (document.readyState === "complete") {
            checkAndHide();
        } else {
            // Wait for page to fully load
            window.addEventListener("load", () => {
                checkAndHide();
            });

            // Fallback: hide after max time
            setTimeout(() => {
                hideLoadingScreen();
                window.__loadingScreenShown = true;
            }, 3000);
        }
    }

    // Start initialization only on first load
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLoadingScreen);
    } else {
        initLoadingScreen();
    }

    // On Astro view transitions, don't show loading screen again
    document.addEventListener("astro:after-swap", () => {
        const loadingScreen = document.getElementById("loading-screen");
        if (loadingScreen) {
            hideLoadingScreen();
        }
    });
</script>
