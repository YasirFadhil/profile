---
interface Props {
    texts: string[];
    speed?: number;
    cursorVisible?: boolean;
}

const { texts, speed = 100, cursorVisible = true } = Astro.props;
---

<div
    class="typing-multi-container"
    data-texts={JSON.stringify(texts)}
    data-speed={speed}
    data-cursor={cursorVisible}
>
    <span class="typing-multi-text"></span>{
        cursorVisible && <span class="typing-multi-cursor" />
    }
</div>

<style>
    .typing-multi-container {
        display: inline-block;
        position: relative;
        width: 100%;
        padding-top: 0.5em;
        min-height: 4.5em;
        line-height: 1.5;
    }

    .typing-multi-text {
        display: inline;
        white-space: normal;
        word-break: break-word;
        color: oklch(80.9% 0.105 251.813);
    }

    .typing-multi-cursor {
        display: inline-block;
        animation: blink 0.7s step-end infinite;
        margin-left: 2px;
        width: 2px;
        height: 1em;
        background-color: currentColor;
        vertical-align: text-bottom;
    }

    @keyframes blink {
        0%,
        49% {
            opacity: 1;
        }
        50%,
        100% {
            opacity: 0;
        }
    }
</style>

<script>
    interface TypingState {
        currentIndex: number;
        timeoutId: ReturnType<typeof setTimeout> | null;
        isRunning: boolean;
    }

    // Map to track typing state for each container
    const typingStates = new WeakMap<Element, TypingState>();

    function getTypingState(container: Element): TypingState {
        if (!typingStates.has(container)) {
            typingStates.set(container, {
                currentIndex: 0,
                timeoutId: null,
                isRunning: false,
            });
        }
        return typingStates.get(container)!;
    }

    function initializeMultiTyping(): void {
        const containers = document.querySelectorAll(".typing-multi-container");

        containers.forEach((container: Element) => {
            const state = getTypingState(container);

            // Cancel any existing timeout
            if (state.timeoutId) {
                clearTimeout(state.timeoutId);
            }

            const textsJson = container.getAttribute("data-texts") || "[]";
            const texts: string[] = JSON.parse(textsJson);
            const speed = parseInt(
                container.getAttribute("data-speed") || "100",
            );
            const typingText = container.querySelector(
                ".typing-multi-text",
            ) as HTMLElement | null;

            if (!typingText || texts.length === 0) return;

            // Reset state
            state.currentIndex = 0;
            state.isRunning = true;
            typingText.textContent = "";

            const fullText = texts[0]; // Only use first text

            const typeCharacter = (): void => {
                if (state.currentIndex < fullText.length) {
                    if (typingText) {
                        typingText.textContent = fullText.substring(
                            0,
                            state.currentIndex + 1,
                        );
                    }
                    state.currentIndex++;
                    state.timeoutId = setTimeout(typeCharacter, speed);
                } else {
                    state.isRunning = false;
                }
            };

            typeCharacter();
        });
    }

    // Run when DOM is ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeMultiTyping);
    } else {
        initializeMultiTyping();
    }

    // Re-initialize after Astro view transitions
    document.addEventListener("astro:after-swap", initializeMultiTyping);
</script>
