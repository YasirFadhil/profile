---
import TypingMulti from "./TypingMulti.astro";

const name = "Muchammad Yassir Nur Fadillah";
const typingTexts = [`Welcome to my website!`, "Nice to meet you!"];
---

<section class="pt-32 pb-20 px-6 relative overflow-hidden">
    <!-- Animated background blob (desktop only) -->
    <div
        class="hidden lg:block absolute -top-40 -right-40 w-80 h-80 bg-linear-to-br from-blue-500/20 to-violet-500/20 rounded-full blur-3xl animate-float"
    >
    </div>
    <div
        class="hidden lg:block absolute -bottom-20 -left-40 w-96 h-96 bg-linear-to-tr from-violet-500/10 to-cyan-500/10 rounded-full blur-3xl animate-float-delayed"
    >
    </div>

    <div class="max-w-6xl mx-auto text-center relative z-10">
        <div class="animate-fadeInUp">
            <h1 class="text-5xl md:text-7xl font-bold mb-6">
                <span
                    class="bg-linear-to-r from-blue-400 via-violet-400 to-cyan-400 bg-clip-text text-transparent"
                >
                    Hello, I'm Yassir
                </span>
            </h1>
            <div
                class="text-xl md:text-2xl text-slate-300 mb-8 max-w-3xl mx-auto leading-relaxed min-h-[3em]"
            >
                <TypingMulti
                    texts={typingTexts}
                    speed={50}
                    cursorVisible={true}
                />
            </div>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href="https://drive.google.com/file/d/1O38GFsVCQ4yXLdH2e0bfHGseYztK5eyk/view?usp=drive_link"
                    target="_blank"
                    class="bg-linear-to-r from-blue-500 to-violet-500 text-white px-8 py-3 rounded-full font-medium hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300 hover:scale-105"
                >
                    Download CV
                </a>
                <a
                    href="/#contact"
                    class="border border-slate-600 text-slate-300 px-8 py-3 rounded-full font-medium hover:border-blue-400 hover:text-blue-400 transition-all duration-300"
                >
                    Get In Touch
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes float {
        0%,
        100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-30px);
        }
    }

    @keyframes float-delayed {
        0%,
        100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(30px);
        }
    }

    .animate-float {
        animation: float 8s ease-in-out infinite;
    }

    .animate-float-delayed {
        animation: float-delayed 10s ease-in-out infinite 2s;
    }
</style>
