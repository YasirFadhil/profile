                    <h1
                        class="text-xl font-bold bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
                    >
                        ysirnf
                    </h1>

                    <!-- Desktop Navigation -->
                    <div class="hidden md:flex space-x-8">
                        <a
                            href="#about"
                            class="text-slate-300 hover:text-blue-400 transition-colors"
