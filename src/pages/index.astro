const hobbies = ["Taking Photos", "Listening to Music", "Gaming"];
const skills = ["Vibe Coding", "Phone Photography", "Word/Canva"];
---

<Layout title={`${name}'s Portfolio`}>
    <div
        class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"
    >
        <!-- Navigation -->
        <nav
