                        >
                        <a
                            href="#projects"
                            class="text-slate-300 hover:text-blue-400 transition-colors"
                            >Projects</a
                        >
                        <a
                            href="#skills"
                            class="text-slate-300 hover:text-blue-400 transition-colors"
                            >Skills</a
                        >
                        <a
                            href="#contact"
                            class="text-slate-300 hover:text-blue-400 transition-colors"
                            >Contact</a
                        >
                    </div>

                    <!-- Mobile Menu Button -->
