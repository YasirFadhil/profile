---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";

const name = "Muchammad Yassir Nur Fadillah";
const description =
    "A passionate student with a love for learning and exploring technology.";
const title = "Home";
const image = "../../public/profile.jpg";

const personalData = {
    name: name,
    title: title,
    description: description,
    image: image,
};
---

<Layout {...personalData}>
    <Navigation />
    <div
        class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"
    >
        <!-- Hero Section -->
        <Hero />

        <!-- About Section - Brief Summary -->
        <section id="about" class="py-20 px-6">
            <div
                class="max-w-6xl mx-auto text-center animate-fadeInUp animate-delay-200"
            >
                <h2
                    class="text-3xl md:text-4xl font-bold mb-6 bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
                >
                    About Me
                </h2>
                <p
                    class="text-slate-300 text-lg mb-8 leading-relaxed max-w-2xl mx-auto"
                >
                    I'm {name}, a passionate student exploring the world of
                    technology. Learn more about my journey, passions, and
                    skills on my dedicated About Me page.
                </p>
                <a
                    href="/about"
                    class="inline-block bg-gradient-to-r from-blue-500 to-violet-500 text-white py-3 px-8 rounded-full font-medium hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300 transform hover:scale-105"
                >
                    Learn More <i class="fas fa-arrow-right ml-2"></i>
                </a>
            </div>
        </section>

        <!-- Projects Section -->
        <Projects />

        <!-- Skills Section -->
        <Skills />

        <!-- Contact Section -->
        <Contact />
    </div>
</Layout>
