---
/*
  Organized imports and constants for maintainability.
  Sections:
  - Imports
  - Meta & Page Info
  - Contact Info
  - Personal Info
  - Education (study)
  - Interests / Arrays (passion, hobbies, skills)
  - Derived data (aboutData, timeline)
*/

//
// Imports
//
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Typing from "../components/TypingAbout.astro";

//
// Meta & Page Info
//
const title = "ysirnf - About Me";
const pagetitle = "About Me";
const description =
  "A passionate student with a love for learning and exploring technology.";
const keywords = ["student", "passion", "technology", "programming"];
const image = "/images/profile.jpg";

//
// Contact Info
//
const email = "yasirfadhil46@gmail.com";
const location = "Klaten, Indonesia";
const social = {
  github: "https://github.com/YasirFadhil",
  x: "https://twitter.com/ysirnf_",
  instagram: "https://www.instagram.com/ysirnf_/",
  whatsapp: "https://wa.me/6287712336358",
};

//
// Personal Info
//
const name = "Muchammad Yassir Nur Fadillah";
const age = 18;
const major = "Network Engineering";
const school = "1st State Vocational High School Klaten";
const typingTexts = [
    `${major} Student at ${school}.`,
];
//
// Education / Study - structured for clarity
//
const study = {
  sd: {
    name: "State Elementary School Patran",
    year: "2014-2016",
    note:
      "Started formal education in Yogyakarta while staying with family — early curiosity and still childish.",
  },
  mi: {
    name: "Muhammadiyah Elementary School Sabranglor",
    year: "2016-2020",
    note:
      "Moved back to hometown and continued elementary school began to learn more and focused on school, task and even participated in school activities on science olympiad.",
  },
  smp: {
    name: "2nd State Junior High School Trucuk",
    year: "2020-2023",
    note:
      "Being covid-19 pandemic strider, I had to adapt to online learning and remote collaboration, which taught me the importance of resilience and adaptability.",
  },
  smk: {
    name: "1st State Vocational High School Klaten",
    year: "2023-2026",
    note:
      "Choosing a vocational tech track (Network Engineering) to gain hands-on skills and practical experience.",
  },
};

//
// Interests & Arrays
//
const passion = ["web development", "photography", "gaming"];

const hobbies = [
  {
    name: "Taking Photos",
    icon: "fa-camera-retro",
    description: "Capturing life moments",
    color: "text-green-400",
  },
  {
    name: "Listening to Music",
    icon: "fa-music",
    description: "Finding rhythm",
    color: "text-purple-400",
  },
  {
    name: "Gaming",
    icon: "fa-gamepad",
    description: "Interactive entertainment",
    color: "text-red-400",
  },
];

const skills = ["HTML", "CSS", "Astro", "Python", "MS Word", "Canva", "Debian", "Arch Linux", "NixOS"];

//
// Derived / Helper data
//
const aboutData = {
  name,
  pagetitle,
  description,
  image,
  keywords,
  social,
  email,
  location,
  age,
  major,
  school,
  passion,
  hobbies,
  skills,
};

// Build a timeline array from `study` so it's easy to render and maintain.
const timeline = [
  {
    key: "sd",
    title: study.sd.name,
    year: study.sd.year,
    icon: "fa-school",
    description: study.sd.note,
  },
  {
    key: "mi",
    title: study.mi.name,
    year: study.mi.year,
    icon: "fa-child",
    description: study.mi.note,
  },
  {
    key: "smp",
    title: study.smp.name,
    year: study.smp.year,
    icon: "fa-graduation-cap",
    description: study.smp.note,
  },
  {
    key: "smk",
    title: study.smk.name,
    year: study.smk.year,
    icon: "fa-network-wired",
    description: study.smk.note,
  },
];
---

<Layout title={title} {...aboutData}>
  <Navigation />
  <div class="min-h-screen pt-20 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Page Title -->
      <div class="mb-16">
        <h1
          class="text-5xl md:text-6xl font-bold text-center bg-linear-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
        >
          {pagetitle}
        </h1>
      </div>

      <!-- Hero / Profile Section -->
      <div class="max-w-5xl mx-auto mb-20">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-center">
          <!-- Profile Image -->
          <div class="md:col-span-1 flex justify-center">
            <div class="profile-photo-container relative w-48 h-48 cursor-pointer">
              <div class="glow-effect absolute inset-0 bg-linear-to-r from-blue-500 to-violet-500 rounded-full blur-lg opacity-75 animate-pulse"></div>
              <img
                src={image}
                alt={name}
                class="relative w-48 h-48 rounded-full border-2 border-blue-400 object-cover transition-transform duration-300"
              />
            </div>
          </div>

          <!-- Profile Info -->
          <div class="md:col-span-2 text-center md:text-left">
            <h2 class="text-4xl md:text-5xl font-bold text-slate-100 mb-3">{name}</h2>
            <p class="text-xl text-blue-300 mb-6 font-medium">
              <Typing texts={typingTexts} speed={60} cursorVisible={true} />
            </p>
            <p class="text-slate-300 text-lg leading-relaxed mb-4">
              {age} years old • Based in {location}
            </p>
            <p class="text-slate-400 text-base leading-relaxed">
              Passionate about crafting beautiful digital experiences and exploring the intersection of technology and creativity.
            </p>
          </div>
        </div>
      </div>

      <!-- About Me Section -->
      <section class="max-w-5xl mx-auto mb-24">
        <div class="relative">
          <div class="absolute -left-4 top-0 bottom-0 w-1 bg-linear-to-b from-blue-500 to-violet-500 rounded-full"></div>
          <div class="pl-8">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-100 mb-8">About Me</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="bg-slate-800/40 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 hover:border-blue-400/40 transition-colors duration-300">
                <p class="text-slate-300 text-lg leading-relaxed">
                  My name is <span class="font-semibold text-slate-100">{name}</span>, and I'm currently <span class="font-semibold text-slate-100">{age}</span> years old. I'm studying at <span class="font-semibold text-slate-100">{school}</span>, majoring in <span class="font-semibold text-blue-300">{major}</span>, where I'm developing my technical skills and passion for technology.
                </p>
              </div>
              <div class="bg-slate-800/40 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 hover:border-violet-400/40 transition-colors duration-300">
                <p class="text-slate-300 text-lg leading-relaxed">
                  I'm passionate about <span class="font-semibold text-violet-300">{passion.join(", ")}</span>, and I love exploring new technologies and creating things that make a difference. Every project is an opportunity to learn and grow.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- My Study / Timeline Section -->
      <section class="max-w-5xl mx-auto mb-24">
        <div class="relative">
          <div class="absolute -left-4 top-0 bottom-0 w-1 bg-linear-to-b from-blue-500 to-violet-500 rounded-full"></div>
          <div class="pl-8">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-100 mb-10">My Study</h2>

            <!-- Timeline container -->
            <div class="relative pl-6">
              <!-- Vertical line -->
              <div class="absolute left-0 top-0 bottom-0 w-px bg-slate-700/40" aria-hidden="true" />

              <div class="space-y-6">
                {
                  timeline.map((item, index) => (
                    <div class="relative group">
                      <!-- Connector dot / icon -->
                      <div class="absolute -left-12 top-6">
                        <div class="w-10 h-10 rounded-full bg-linear-to-br from-blue-500 to-violet-500 flex items-center justify-center text-white shadow-lg group-hover:scale-110 transition-transform duration-300">
                          <i class={`fas ${item.icon} text-sm`} />
                        </div>
                      </div>

                      <!-- Card -->
                      <div class="bg-gradient-to-br from-slate-800/60 to-slate-900/40 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 hover:border-blue-400/60 hover:from-slate-800/80 hover:to-slate-900/60 transition-all duration-300 group-hover:shadow-lg group-hover:shadow-blue-500/20">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                          <h3 class="text-xl font-semibold text-slate-100">{item.title}</h3>
                          <span class="inline-block text-sm text-slate-400 font-medium bg-slate-700/30 px-3 py-1 rounded-full">{item.year}</span>
                        </div>
                        <p class="text-slate-400 text-base leading-relaxed mb-4">
                          {item.description}
                        </p>
                        <div class="flex flex-wrap gap-2">
                          <span class="text-xs bg-blue-500/20 text-blue-300 px-3 py-1 rounded-full font-medium">Learning</span>
                          <span class="text-xs bg-violet-500/20 text-violet-300 px-3 py-1 rounded-full font-medium">Growth</span>
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- My Hobbies Section -->
      <section class="max-w-5xl mx-auto mb-24">
        <div class="relative">
          <div class="absolute -left-4 top-0 h-16 w-1 bg-linear-to-b from-blue-500 to-violet-500 rounded-full"></div>
          <div class="pl-8">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-100 mb-10">My Hobbies</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {
                hobbies.map((hobby) => (
                  <div class="group relative bg-gradient-to-br from-slate-800/50 to-slate-900/30 backdrop-blur-sm border border-slate-700/50 p-8 rounded-2xl hover:border-blue-400/60 hover:from-slate-800/70 hover:to-slate-900/50 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">
                    <div class="mb-4 inline-flex p-4 rounded-xl bg-slate-700/30 group-hover:bg-slate-700/50 transition-colors duration-300">
                      <i class={`fas ${hobby.icon} ${hobby.color} text-3xl`} />
                    </div>
                    <h3 class="text-xl font-semibold text-slate-100 mb-2">{hobby.name}</h3>
                    <p class="text-slate-400 text-base">{hobby.description}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- My Skills Section -->
      <section class="max-w-5xl mx-auto mb-24">
        <div class="relative">
          <div class="absolute -left-4 top-0 h-16 w-1 bg-linear-to-b from-blue-500 to-violet-500 rounded-full"></div>
          <div class="pl-8">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-100 mb-10">My Skills</h2>
            <div class="flex flex-wrap gap-3 justify-start">
              {
                skills.map((skill) => (
                  <span class="px-5 py-2.5 bg-gradient-to-r from-blue-500/20 to-violet-500/20 text-slate-200 text-base font-medium rounded-full border border-blue-400/30 hover:border-blue-400/60 hover:from-blue-500/30 hover:to-violet-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">
                    {skill}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Connect with Me Section -->
      <section class="max-w-5xl mx-auto">
        <div class="relative">
          <div class="absolute -left-4 top-0 h-24 w-1 bg-linear-to-b from-blue-500 to-violet-500 rounded-full"></div>
          <div class="pl-8">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-100 mb-10">Connect with Me</h2>

            <!-- Social Icons -->
            <div class="flex flex-wrap gap-6 mb-10 justify-start">
              {
                social.github && (
                  <a href={social.github} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-center w-14 h-14 rounded-full bg-slate-800/50 border border-slate-700/50 hover:border-blue-400/60 hover:bg-slate-800/70 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">
                    <i class="fab fa-github text-slate-300 group-hover:text-blue-400 text-xl transition-colors" />
                  </a>
                )
              }
              {
                social.x && (
                  <a href={social.x} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-center w-14 h-14 rounded-full bg-slate-800/50 border border-slate-700/50 hover:border-blue-400/60 hover:bg-slate-800/70 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">
                    <i class="fab fa-x-twitter text-slate-300 group-hover:text-blue-400 text-xl transition-colors" />
                  </a>
                )
              }
              {
                social.instagram && (
                  <a href={social.instagram} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-center w-14 h-14 rounded-full bg-slate-800/50 border border-slate-700/50 hover:border-pink-400/60 hover:bg-slate-800/70 transition-all duration-300 hover:shadow-lg hover:shadow-pink-500/20">
                    <i class="fab fa-instagram text-slate-300 group-hover:text-pink-400 text-xl transition-colors" />
                  </a>
                )
              }
              {
                social.whatsapp && (
                  <a href={social.whatsapp} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-center w-14 h-14 rounded-full bg-slate-800/50 border border-slate-700/50 hover:border-green-400/60 hover:bg-slate-800/70 transition-all duration-300 hover:shadow-lg hover:shadow-green-500/20">
                    <i class="fab fa-whatsapp text-slate-300 group-hover:text-green-400 text-xl transition-colors" />
                  </a>
                )
              }
            </div>

            <!-- Contact Info -->
            <div class="space-y-3">
              <p class="text-slate-300 text-lg">
                Email: <a href={`mailto:${email}`} class="text-blue-400 hover:text-blue-300 font-medium transition-colors">{email}</a>
              </p>
              <p class="text-slate-300 text-lg">
                Location: <span class="font-medium text-slate-200">{location}</span>
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .profile-photo-container {
    transition: transform 0.3s ease;
  }

  .profile-photo-container:hover .glow-effect,
  .profile-photo-container:active .glow-effect {
    animation: bloom 0.6s ease-out;
  }

  .profile-photo-container:hover img,
  .profile-photo-container:active img {
    transform: scale(1.05);
  }

  @keyframes bloom {
    0% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7);
      opacity: 0.75;
    }
    50% {
      box-shadow: 0 0 0 30px rgba(59, 130, 246, 0);
      opacity: 1;
    }
    100% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
      opacity: 0.75;
    }
  }
</style>
