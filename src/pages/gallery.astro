---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
const title = "ysirnf - Gallery";

const name = "Muchammad Yassir Nur Fadillah";

const photos = [
    {
        id: 1,
        url: "/photos/photo1.webp",
        alt: "Interior Architecture",
        category: "architecture",
        title: "Stairway Light",
        description: "Interior architectural perspective featuring stairs, railings, and natural light streaming through an opening"
    },
    {
        id: 2,
        url: "/photos/photo2.webp",
        alt: "Sunset Landscape",
        category: "landscape",
        title: "Golden Sunset",
        description: "Dramatic sunset with warm orange-pink sky and silhouetted tropical vegetation creating a serene evening scene"
    },
    {
        id: 3,
        url: "/photos/photo3.webp",
        alt: "Grass and Sky",
        category: "nature",
        title: "Ground Level View",
        description: "Close-up perspective of lush green grass with architectural structures blurred in the background under a moody sky"
    },
    {
        id: 4,
        url: "/photos/photo4.webp",
        alt: "Mosque Interior",
        category: "architecture",
        title: "Sacred Architecture",
        description: "Beautiful interior of a mosque featuring ornate Islamic decorations, golden details, intricate patterns, and a person in prayer on traditional carpets"
    },
    {
        id: 5,
        url: "/photos/photo5.webp",
        alt: "Butterfly in Foliage",
        category: "nature",
        title: "Garden Discovery",
        description: "A delicate butterfly resting among lush green leaves, showcasing the intricate beauty of nature's small wonders"
    },
    {
        id: 6,
        url: "/photos/photo6.webp",
        alt: "Sunset Water Reflection",
        category: "landscape",
        title: "Storm's Reflection",
        description: "Spectacular sunset perfectly reflected in a small water pool formed after a storm, with dramatic sky colors mirrored in the still water and framed by silhouetted trees"
    },
    {
        id: 7,
        url: "/photos/photo7.webp",
        alt: "Seascape at Golden Hour",
        category: "landscape",
        title: "Fishing Fleet Sunset",
        description: "Golden hour seascape with traditional fishing boats scattered across calm waters, capturing the peaceful end of a working day at sea"
    },
    {
        id: 8,
        url: "/photos/photo8.webp",
        alt: "Framed Sunset Seascape",
        category: "landscape",
        title: "Natural Window",
        description: "Sunset over the ocean beautifully framed by silhouetted tree branches and foliage, creating a natural window to the golden seascape"
    },
    {
        id: 9,
        url: "/photos/photo9.webp",
        alt: "Rice Field at Golden Hour",
        category: "landscape",
        title: "Golden Harvest",
        description: "Dramatic sunset over lush green rice fields with spectacular orange-pink sky and clouds creating a breathtaking rural landscape"
    },
    {
        id: 10,
        url: "/photos/photo10.webp",
        alt: "Twilight Silhouette",
        category: "nature",
        title: "Evening Branches",
        description: "Bare tree branches silhouetted against a dusky twilight sky with power lines creating geometric patterns in the fading light"
    },
    {
        id: 11,
        url: "/photos/photo11.webp",
        alt: "Pink Flower Close-up",
        category: "nature",
        title: "Delicate Bloom",
        description: "A beautiful pink flower captured in intimate detail, showcasing nature's delicate beauty with soft focus background"
    },
    {
        id: 12,
        url: "/photos/photo12.webp",
        alt: "Red Garden Flower",
        category: "nature",
        title: "Vibrant Bloom",
        description: "A striking red flower captured in a lush garden setting, showcasing vibrant petals with beautiful natural lighting and bokeh background"
    },
    {
        id: 13,
        url: "/photos/photo13.webp",
        alt: "Illuminated Monument at Night",
        category: "architecture",
        title: "Tugu Yogyakarta",
        description: "Historic Tugu Yogyakarta monument beautifully illuminated at night, showcasing traditional Javanese architecture with dramatic nighttime lighting and urban surroundings"
    }
];

const categories = ["all", "architecture", "landscape", "nature"];
---

<Layout title={title}>

    <Navigation />
    <div class="min-h-screen pt-20">
        <!-- Hero Section -->
        <section class="pt-12 pb-20 px-6">
            <div class="max-w-6xl mx-auto text-center">
                <div class="animate-fadeInUp">
                    <h1 class="text-5xl md:text-6xl font-bold mb-6">
                        <span class="bg-linear-to-r from-blue-400 via-violet-400 to-cyan-400 bg-clip-text text-transparent">
                            Photography Gallery
                        </span>
                    </h1>
                    <p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-3xl mx-auto leading-relaxed">
                        Capturing life's moments through mobile photography - every shot tells a story
                    </p>
                </div>
            </div>
        </section>

        <!-- Filter Buttons -->
        <section class="pb-12 px-6">
            <div class="max-w-6xl mx-auto">
                <div class="flex flex-wrap justify-center gap-4 mb-12">
                    {categories.map((category) => (
                        <button
                            class={`filter-btn px-6 py-3 rounded-full border transition-all duration-300 capitalize ${
                                category === 'all'
                                    ? 'bg-linear-to-r from-blue-500 to-violet-500 text-white border-transparent'
                                    : 'border-slate-600 text-slate-300 hover:border-blue-400 hover:text-blue-400'
                            }`}
                            data-filter={category}
                        >
                            {category === 'all' ? 'All Photos' : category}
                        </button>
                    ))}
                </div>
            </div>
        </section>

        <!-- Photo Gallery -->
        <section class="pb-20 px-6">
            <div class="max-w-7xl mx-auto">
                <div id="photo-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {photos.map((photo) => (
                        <div
                            class={`photo-item group cursor-pointer`}
                            data-category={photo.category}
                            data-photo-id={photo.id}
                        >
                            <div class="bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 rounded-2xl overflow-hidden hover:border-blue-400/50 hover:bg-slate-700/50">
                                <!-- Photo with blur placeholder -->
                                <div class="aspect-square bg-linear-to-br from-blue-500/20 to-violet-500/20 relative overflow-hidden">
                                    <!-- Loading placeholder -->
                                    <div class="absolute inset-0 bg-slate-700/30 flex items-center justify-center loading-placeholder">
                                        <i class="fas fa-camera text-2xl text-slate-500"></i>
                                    </div>
                                    <!-- Actual image - lazy loaded -->
                                    <img
                                        src={photo.url}
                                        alt={photo.alt}
                                        class="w-full h-full object-cover lazy-img cursor-pointer"
                                        loading="lazy"
                                        decoding="async"
                                        data-modal-trigger
                                    />
                                </div>

                                <!-- Photo Info -->
                                <div class="p-6">
                                    <h3 class="text-lg font-semibold text-slate-200 mb-2 line-clamp-1">{photo.title}</h3>
                                    <p class="text-slate-400 text-sm mb-3 line-clamp-2">{photo.description}</p>
                                    <div class="flex justify-between items-center">
                                        <span class="px-3 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-full capitalize">
                                            {photo.category}
                                        </span>
                                        <button class="text-slate-400 hover:text-blue-400 transition-colors" aria-label={`Expand ${photo.title}`}>
                                            <i class="fas fa-expand-alt text-sm"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <!-- No photos message -->
                <div id="no-photos" class="text-center py-20 hidden">
                    <i class="fas fa-camera text-6xl text-slate-600 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-slate-300 mb-2">No photos found</h3>
                    <p class="text-slate-400">Try selecting a different category</p>
                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="pb-20 px-6">
            <div class="max-w-4xl mx-auto text-center">
                <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-8">
                    <h2 class="text-3xl font-bold mb-4 bg-linear-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">
                        Like What You See?
                    </h2>
                    <p class="text-slate-300 text-lg mb-6">
                        Follow me on social media for more photography updates and behind-the-scenes content
                    </p>
                    <div class="flex justify-center gap-4">
                        <a
                            href="https://instagram.com/ysirnf_"
                            target="_blank"
                            class="bg-linear-to-r from-pink-500 to-rose-500 text-white px-6 py-3 rounded-full font-medium hover:shadow-lg hover:shadow-pink-500/25 transition-all duration-300 hover:scale-105"
                        >
                            <i class="fab fa-instagram mr-2"></i>
                            Follow on Instagram
                        </a>
                        <a
                            href="/#contact"
                            class="border border-slate-600 text-slate-300 px-6 py-3 rounded-full font-medium hover:border-blue-400 hover:text-blue-400 transition-all duration-300"
                        >
                            Get In Touch
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Photo Modal/Lightbox -->
    <div id="photo-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden z-50 p-4" style="display: none; align-items: center; justify-content: center;">
        <div class="relative max-w-4xl w-full max-h-[90vh] flex flex-col">
            <!-- Close button -->
            <button
                id="modal-close"
                class="absolute -top-10 right-0 text-slate-300 hover:text-white transition-colors z-10"
                aria-label="Close modal"
            >
                <i class="fas fa-times text-3xl"></i>
            </button>

            <!-- Modal Content -->
            <div class="bg-slate-900/95 backdrop-blur rounded-2xl overflow-hidden flex flex-col h-full">
                <!-- Image Container -->
                <div class="flex-1 flex items-center justify-center overflow-hidden bg-slate-950 relative">
                    <img
                        id="modal-image"
                        src=""
                        alt=""
                        class="max-w-full max-h-full object-contain"
                    />
                </div>

                <!-- Info Section -->
                <div class="p-6 border-t border-slate-700">
                    <h2 id="modal-title" class="text-2xl font-bold text-slate-200 mb-2"></h2>
                    <p id="modal-description" class="text-slate-400 mb-4"></p>
                    <div class="flex items-center justify-between">
                        <span id="modal-category" class="px-4 py-2 bg-blue-500/20 text-blue-300 text-sm rounded-full capitalize"></span>
                        <div class="flex gap-2">
                            <button
                                id="modal-prev"
                                class="p-2 rounded-full border border-slate-600 text-slate-300 hover:border-blue-400 hover:text-blue-400 transition-colors"
                                aria-label="Previous photo"
                            >
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button
                                id="modal-next"
                                class="p-2 rounded-full border border-slate-600 text-slate-300 hover:border-blue-400 hover:text-blue-400 transition-colors"
                                aria-label="Next photo"
                            >
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gallery optimization script -->
    <script is:inline>
        // Image loading optimization with IntersectionObserver
        function initGalleryImages() {
            const images = document.querySelectorAll('.lazy-img');

            if ('IntersectionObserver' in window) {
                const imageObserver = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            const placeholder = img.previousElementSibling;

                            const onImageLoad = () => {
                                if (placeholder) {
                                    placeholder.classList.add('hidden');
                                }
                            };

                            const onImageError = () => {
                                if (placeholder) {
                                    placeholder.classList.remove('hidden');
                                }
                            };

                            img.addEventListener('load', onImageLoad);
                            img.addEventListener('error', onImageError);

                            imageObserver.unobserve(img);
                        }
                    });
                });

                images.forEach((img) => {
                    imageObserver.observe(img);
                });
            } else {
                // Fallback for older browsers
                images.forEach((img) => {
                    const placeholder = img.previousElementSibling;
                    const onImageLoad = () => {
                        if (placeholder) {
                            placeholder.classList.add('hidden');
                        }
                    };
                    img.addEventListener('load', onImageLoad);
                });
            }
        }

        // Initialize on page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initGalleryImages);
        } else {
            initGalleryImages();
        }

        // Reinitialize after ViewTransitions
        document.addEventListener('astro:after-swap', initGalleryImages);
    </script>

    <!-- Modal functionality script -->
    <script is:inline define:vars={{ photos }}>
        function initPhotoModal() {
            const modal = document.getElementById('photo-modal');
            const modalImage = document.getElementById('modal-image');
            const modalTitle = document.getElementById('modal-title');
            const modalDescription = document.getElementById('modal-description');
            const modalCategory = document.getElementById('modal-category');
            const closeBtn = document.getElementById('modal-close');
            const prevBtn = document.getElementById('modal-prev');
            const nextBtn = document.getElementById('modal-next');
            const photoItems = document.querySelectorAll('.photo-item');

            let currentPhotoIndex = 0;
            const visiblePhotos = Array.from(photoItems).map(item => {
                const id = parseInt(item.getAttribute('data-photo-id'));
                return photos.find(p => p.id === id);
            });

            function updateModal(photo) {
                modalImage.src = photo.url;
                modalImage.alt = photo.alt;
                modalTitle.textContent = photo.title;
                modalDescription.textContent = photo.description;
                modalCategory.textContent = photo.category;
            }

            function openModal(photoId) {
                const photo = photos.find(p => p.id === photoId);
                currentPhotoIndex = visiblePhotos.findIndex(p => p.id === photoId);
                if (photo) {
                    updateModal(photo);
                    modal.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                }
            }

            function closeModal() {
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }

            function showNextPhoto() {
                currentPhotoIndex = (currentPhotoIndex + 1) % visiblePhotos.length;
                updateModal(visiblePhotos[currentPhotoIndex]);
            }

            function showPrevPhoto() {
                currentPhotoIndex = (currentPhotoIndex - 1 + visiblePhotos.length) % visiblePhotos.length;
                updateModal(visiblePhotos[currentPhotoIndex]);
            }

            // Event listeners
            photoItems.forEach(item => {
                item.addEventListener('click', () => {
                    const photoId = parseInt(item.getAttribute('data-photo-id'));
                    openModal(photoId);
                });
            });

            closeBtn.addEventListener('click', closeModal);
            prevBtn.addEventListener('click', showPrevPhoto);
            nextBtn.addEventListener('click', showNextPhoto);

            // Close on background click
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    closeModal();
                }
            });

            // Keyboard navigation
            document.addEventListener('keydown', (e) => {
                if (modal.classList.contains('hidden')) return;
                if (e.key === 'Escape') closeModal();
                if (e.key === 'ArrowRight') showNextPhoto();
                if (e.key === 'ArrowLeft') showPrevPhoto();
            });
        }

        // Initialize modal
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPhotoModal);
        } else {
            initPhotoModal();
        }

        // Reinitialize after ViewTransitions
        document.addEventListener('astro:after-swap', initPhotoModal);
    </script>

    <!-- Load gallery-specific script (filtering) -->
    <script src="/js/gallery.js" defer></script>
</Layout>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .loading-placeholder {
        z-index: 10;
    }

    .lazy-img.loaded ~ .loading-placeholder {
        display: none;
    }

    #photo-modal {
        animation: fadeIn 0.3s ease-in-out;
    }

    #photo-modal:not(.hidden) {
        display: flex !important;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>
