---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";

const name = "Muchammad Yassir Nur Fadillah";

// Your actual photos in WebP format
const photos = [
    {
        id: 1,
        url: "/photos/photo1.webp",
        alt: "Interior Architecture",
        category: "architecture",
        title: "Stairway Light",
        description: "Interior architectural perspective featuring stairs, railings, and natural light streaming through an opening"
    },
    {
        id: 2,
        url: "/photos/photo2.webp",
        alt: "Sunset Landscape",
        category: "landscape",
        title: "Golden Sunset",
        description: "Dramatic sunset with warm orange-pink sky and silhouetted tropical vegetation creating a serene evening scene"
    },
    {
        id: 3,
        url: "/photos/photo3.webp",
        alt: "Grass and Sky",
        category: "nature",
        title: "Ground Level View",
        description: "Close-up perspective of lush green grass with architectural structures blurred in the background under a moody sky"
    },
    {
        id: 4,
        url: "/photos/photo4.webp",
        alt: "Mosque Interior",
        category: "architecture",
        title: "Sacred Architecture",
        description: "Beautiful interior of a mosque featuring ornate Islamic decorations, golden details, intricate patterns, and a person in prayer on traditional carpets"
    },
    {
        id: 5,
        url: "/photos/photo5.webp",
        alt: "Butterfly in Foliage",
        category: "nature",
        title: "Garden Discovery",
        description: "A delicate butterfly resting among lush green leaves, showcasing the intricate beauty of nature's small wonders"
    },
    {
        id: 6,
        url: "/photos/photo6.webp",
        alt: "Sunset Water Reflection",
        category: "landscape",
        title: "Storm's Reflection",
        description: "Spectacular sunset perfectly reflected in a small water pool formed after a storm, with dramatic sky colors mirrored in the still water and framed by silhouetted trees"
    },
    {
        id: 7,
        url: "/photos/photo7.webp",
        alt: "Seascape at Golden Hour",
        category: "landscape",
        title: "Fishing Fleet Sunset",
        description: "Golden hour seascape with traditional fishing boats scattered across calm waters, capturing the peaceful end of a working day at sea"
    },
    {
        id: 8,
        url: "/photos/photo8.webp",
        alt: "Framed Sunset Seascape",
        category: "landscape",
        title: "Natural Window",
        description: "Sunset over the ocean beautifully framed by silhouetted tree branches and foliage, creating a natural window to the golden seascape"
    },
    {
        id: 9,
        url: "/photos/photo9.webp",
        alt: "Rice Field at Golden Hour",
        category: "landscape",
        title: "Golden Harvest",
        description: "Dramatic sunset over lush green rice fields with spectacular orange-pink sky and clouds creating a breathtaking rural landscape"
    },
    {
        id: 10,
        url: "/photos/photo10.webp",
        alt: "Twilight Silhouette",
        category: "nature",
        title: "Evening Branches",
        description: "Bare tree branches silhouetted against a dusky twilight sky with power lines creating geometric patterns in the fading light"
    },
    {
        id: 11,
        url: "/photos/photo11.webp",
        alt: "Pink Flower Close-up",
        category: "nature",
        title: "Delicate Bloom",
        description: "A beautiful pink flower captured in intimate detail, showcasing nature's delicate beauty with soft focus background"
    },
    {
        id: 12,
        url: "/photos/photo12.webp",
        alt: "Red Garden Flower",
        category: "nature",
        title: "Vibrant Bloom",
        description: "A striking red flower captured in a lush garden setting, showcasing vibrant petals with beautiful natural lighting and bokeh background"
    },
    {
        id: 13,
        url: "/photos/photo13.webp",
        alt: "Illuminated Monument at Night",
        category: "architecture",
        title: "Tugu Yogyakarta",
        description: "Historic Tugu Yogyakarta monument beautifully illuminated at night, showcasing traditional Javanese architecture with dramatic nighttime lighting and urban surroundings"
    }
];

const categories = ["all", "street", "nature", "portrait", "architecture", "landscape"];
---

<Layout title="Photography Gallery - Yassir">
    <Navigation />
    <div class="min-h-screen bg-linear-to-r from-slate-900 via-slate-800 to-slate-900 pt-20">
        <!-- Hero Section -->
        <section class="pt-12 pb-20 px-6">
            <div class="max-w-6xl mx-auto text-center">
                <div class="animate-fadeInUp">
                    <h1 class="text-5xl md:text-6xl font-bold mb-6">
                        <span class="bg-linear-to-r from-blue-400 via-violet-400 to-cyan-400 bg-clip-text text-transparent">
                            Photography Gallery
                        </span>
                    </h1>
                    <p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-3xl mx-auto leading-relaxed">
                        Capturing life's moments through mobile photography - every shot tells a story
                    </p>
                </div>
            </div>
        </section>

        <!-- Filter Buttons -->
        <section class="pb-12 px-6">
            <div class="max-w-6xl mx-auto">
                <div class="flex flex-wrap justify-center gap-4 mb-12">
                    {categories.map((category) => (
                        <button
                            class={`filter-btn px-6 py-3 rounded-full border transition-all duration-300 capitalize ${
                                category === 'all'
                                    ? 'bg-linear-to-r from-blue-500 to-violet-500 text-white border-transparent'
                                    : 'border-slate-600 text-slate-300 hover:border-blue-400 hover:text-blue-400'
                            }`}
                            data-filter={category}
                        >
                            {category === 'all' ? 'All Photos' : category}
                        </button>
                    ))}
                </div>
            </div>
        </section>

        <!-- Photo Gallery -->
        <section class="pb-20 px-6">
            <div class="max-w-7xl mx-auto">
                <div id="photo-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {photos.map((photo) => (
                        <div
                            class={`photo-item group cursor-pointer animate-fadeInUp`}
                            data-category={photo.category}
                            style={`animation-delay: ${Math.random() * 0.5}s; opacity: 0;`}
                        >
                            <div class="bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 rounded-2xl overflow-hidden hover:border-blue-400/50 hover:bg-slate-700/50 transition-all duration-300 hover:scale-105">
                                <!-- Photo placeholder with gradient background -->
                                <div class="aspect-square bg-linear-to-br from-blue-500/20 to-violet-500/20 relative overflow-hidden">
                                    <div class="absolute inset-0 flex items-center justify-center">
                                        <div class="text-center text-slate-400">
                                            <i class="fas fa-camera text-4xl mb-2"></i>
                                            <p class="text-sm">{photo.title}</p>
                                        </div>
                                    </div>
                                    <!-- Your actual photos -->
                                    <img
                                        src={photo.url}
                                        alt={photo.alt}
                                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                </div>

                                <!-- Photo Info -->
                                <div class="p-6">
                                    <h3 class="text-xl font-semibold text-slate-200 mb-2">{photo.title}</h3>
                                    <p class="text-slate-400 text-sm mb-3">{photo.description}</p>
                                    <div class="flex justify-between items-center">
                                        <span class="px-3 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-full capitalize">
                                            {photo.category}
                                        </span>
                                        <button class="text-slate-400 hover:text-blue-400 transition-colors" aria-label={`Expand ${photo.title}`}>
                                            <i class="fas fa-expand-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <!-- No photos message -->
                <div id="no-photos" class="text-center py-20 hidden">
                    <i class="fas fa-camera text-6xl text-slate-600 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-slate-300 mb-2">No photos found</h3>
                    <p class="text-slate-400">Try selecting a different category</p>
                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="pb-20 px-6">
            <div class="max-w-4xl mx-auto text-center">
                <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-8">
                    <h2 class="text-3xl font-bold mb-4 bg-linear-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">
                        Like What You See?
                    </h2>
                    <p class="text-slate-300 text-lg mb-6">
                        Follow me on social media for more photography updates and behind-the-scenes content
                    </p>
                    <div class="flex justify-center gap-4">
                        <a
                            href="https://instagram.com/yasirfadhil"
                            target="_blank"
                            class="bg-linear-to-r from-pink-500 to-rose-500 text-white px-6 py-3 rounded-full font-medium hover:shadow-lg hover:shadow-pink-500/25 transition-all duration-300 hover:scale-105"
                        >
                            <i class="fab fa-instagram mr-2"></i>
                            Follow on Instagram
                        </a>
                        <a
                            href="/#contact"
                            class="border border-slate-600 text-slate-300 px-6 py-3 rounded-full font-medium hover:border-blue-400 hover:text-blue-400 transition-all duration-300"
                        >
                            Get In Touch
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Load gallery-specific script (filtering + animations). navigation.js is loaded globally via Layout.astro -->
    <script src="/js/gallery.js" defer></script>
</Layout>
