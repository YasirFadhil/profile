---
import Layout from "../layouts/Layout.astro";

const name = "Muchammad Yassir Nur Fadillah";

// Your actual photos in WebP format
const photos = [
    {
        id: 1,
        url: "/photos/photo1.webp",
        alt: "Urban Architecture",
        category: "architecture",
        title: "City Lines",
        description: "Modern architectural geometry captured in natural light"
    },
    {
        id: 2,
        url: "/photos/photo2.webp",
        alt: "Street Scene",
        category: "street",
        title: "Daily Life",
        description: "Candid moments of everyday street photography"
    },
    {
        id: 3,
        url: "/photos/photo3.webp",
        alt: "Nature Close-up",
        category: "nature",
        title: "Natural Details",
        description: "The beauty found in nature's intricate patterns"
    },
    {
        id: 4,
        url: "/photos/photo4.webp",
        alt: "Landscape View",
        category: "landscape",
        title: "Wide Horizons",
        description: "Expansive views showcasing natural landscapes"
    },
    {
        id: 5,
        url: "/photos/photo5.webp",
        alt: "Urban Photography",
        category: "street",
        title: "City Vibes",
        description: "Capturing the energy and rhythm of urban life"
    },
    {
        id: 6,
        url: "/photos/photo6.webp",
        alt: "Portrait Style",
        category: "portrait",
        title: "Human Moments",
        description: "Personal expressions and emotional captures"
    },
    {
        id: 7,
        url: "/photos/photo7.webp",
        alt: "Architecture Details",
        category: "architecture",
        title: "Structural Beauty",
        description: "Focusing on architectural details and textures"
    },
    {
        id: 8,
        url: "/photos/photo8.webp",
        alt: "Street Art",
        category: "street",
        title: "Urban Canvas",
        description: "Creative expressions found on city walls"
    },
    {
        id: 9,
        url: "/photos/photo9.webp",
        alt: "Natural Light",
        category: "nature",
        title: "Golden Moments",
        description: "Playing with natural light and shadows"
    },
    {
        id: 10,
        url: "/photos/photo10.webp",
        alt: "Evening Scene",
        category: "landscape",
        title: "Twilight Views",
        description: "Capturing the magic of evening light"
    },
    {
        id: 11,
        url: "/photos/photo11.webp",
        alt: "Morning Light",
        category: "nature",
        title: "Dawn Capture",
        description: "Early morning photography with soft lighting"
    },
    {
        id: 12,
        url: "/photos/photo12.webp",
        alt: "Urban Details",
        category: "street",
        title: "City Textures",
        description: "Finding beauty in urban environments"
    },
    {
        id: 13,
        url: "/photos/photo13.webp",
        alt: "Scenic Landscape",
        category: "landscape",
        title: "Natural Vista",
        description: "Breathtaking landscape photography"
    }
];

const categories = ["all", "street", "nature", "portrait", "architecture", "landscape"];
---

<Layout title="Photography Gallery - Yassir">
    <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        <!-- Navigation -->
        <nav class="fixed top-0 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-700/50 z-50">
            <div class="max-w-6xl mx-auto px-6 py-4">
                <div class="flex justify-between items-center">
                    <a href="/" class="text-xl font-bold bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">
                        Yassir
                    </a>

                    <!-- Desktop Navigation -->
                    <div class="hidden md:flex space-x-8">
                        <a href="/" class="text-slate-300 hover:text-blue-400 transition-colors">Home</a>
                        <a href="/gallery" class="text-blue-400 font-medium">Gallery</a>
                        <a href="/#about" class="text-slate-300 hover:text-blue-400 transition-colors">About</a>
                        <a href="/#contact" class="text-slate-300 hover:text-blue-400 transition-colors">Contact</a>
                    </div>

                    <!-- Mobile Menu Button -->
                    <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-blue-400 transition-colors">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>

                <!-- Mobile Menu -->
                <div id="mobile-menu" class="md:hidden hidden absolute top-full left-0 w-full bg-slate-900/95 backdrop-blur-md border-b border-slate-700/50">
                    <div class="px-6 py-4 space-y-4">
                        <a href="/" class="block text-slate-300 hover:text-blue-400 transition-colors mobile-nav-link">Home</a>
                        <a href="/gallery" class="block text-blue-400 font-medium mobile-nav-link">Gallery</a>
                        <a href="/#about" class="block text-slate-300 hover:text-blue-400 transition-colors mobile-nav-link">About</a>
                        <a href="/#contact" class="block text-slate-300 hover:text-blue-400 transition-colors mobile-nav-link">Contact</a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <section class="pt-32 pb-20 px-6">
            <div class="max-w-6xl mx-auto text-center">
                <div class="animate-fadeInUp">
                    <h1 class="text-5xl md:text-6xl font-bold mb-6">
                        <span class="bg-gradient-to-r from-blue-400 via-violet-400 to-cyan-400 bg-clip-text text-transparent">
                            Photography Gallery
                        </span>
                    </h1>
                    <p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-3xl mx-auto leading-relaxed">
                        Capturing life's moments through mobile photography - every shot tells a story
                    </p>
                </div>
            </div>
        </section>

        <!-- Filter Buttons -->
        <section class="pb-12 px-6">
            <div class="max-w-6xl mx-auto">
                <div class="flex flex-wrap justify-center gap-4 mb-12">
                    {categories.map((category) => (
                        <button
                            class={`filter-btn px-6 py-3 rounded-full border transition-all duration-300 capitalize ${
                                category === 'all'
                                    ? 'bg-gradient-to-r from-blue-500 to-violet-500 text-white border-transparent'
                                    : 'border-slate-600 text-slate-300 hover:border-blue-400 hover:text-blue-400'
                            }`}
                            data-filter={category}
                        >
                            {category === 'all' ? 'All Photos' : category}
                        </button>
                    ))}
                </div>
            </div>
        </section>

        <!-- Photo Gallery -->
        <section class="pb-20 px-6">
            <div class="max-w-7xl mx-auto">
                <div id="photo-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {photos.map((photo) => (
                        <div
                            class={`photo-item group cursor-pointer animate-fadeInUp`}
                            data-category={photo.category}
                            style={`animation-delay: ${Math.random() * 0.5}s; opacity: 0;`}
                        >
                            <div class="bg-slate-800/70 backdrop-blur-sm border border-slate-600/50 rounded-2xl overflow-hidden hover:border-blue-400/50 hover:bg-slate-700/50 transition-all duration-300 hover:scale-105">
                                <!-- Photo placeholder with gradient background -->
                                <div class="aspect-square bg-gradient-to-br from-blue-500/20 to-violet-500/20 relative overflow-hidden">
                                    <div class="absolute inset-0 flex items-center justify-center">
                                        <div class="text-center text-slate-400">
                                            <i class="fas fa-camera text-4xl mb-2"></i>
                                            <p class="text-sm">{photo.title}</p>
                                        </div>
                                    </div>
                                    <!-- Your actual photos -->
                                    <img
                                        src={photo.url}
                                        alt={photo.alt}
                                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                </div>

                                <!-- Photo Info -->
                                <div class="p-6">
                                    <h3 class="text-xl font-semibold text-slate-200 mb-2">{photo.title}</h3>
                                    <p class="text-slate-400 text-sm mb-3">{photo.description}</p>
                                    <div class="flex justify-between items-center">
                                        <span class="px-3 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-full capitalize">
                                            {photo.category}
                                        </span>
                                        <button class="text-slate-400 hover:text-blue-400 transition-colors">
                                            <i class="fas fa-expand-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <!-- No photos message -->
                <div id="no-photos" class="text-center py-20 hidden">
                    <i class="fas fa-camera text-6xl text-slate-600 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-slate-300 mb-2">No photos found</h3>
                    <p class="text-slate-400">Try selecting a different category</p>
                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="pb-20 px-6">
            <div class="max-w-4xl mx-auto text-center">
                <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-8">
                    <h2 class="text-3xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">
                        Like What You See?
                    </h2>
                    <p class="text-slate-300 text-lg mb-6">
                        Follow me on social media for more photography updates and behind-the-scenes content
                    </p>
                    <div class="flex justify-center gap-4">
                        <a
                            href="https://instagram.com/yasirfadhil"
                            target="_blank"
                            class="bg-gradient-to-r from-pink-500 to-rose-500 text-white px-6 py-3 rounded-full font-medium hover:shadow-lg hover:shadow-pink-500/25 transition-all duration-300 hover:scale-105"
                        >
                            <i class="fab fa-instagram mr-2"></i>
                            Follow on Instagram
                        </a>
                        <a
                            href="/#contact"
                            class="border border-slate-600 text-slate-300 px-6 py-3 rounded-full font-medium hover:border-blue-400 hover:text-blue-400 transition-all duration-300"
                        >
                            Get In Touch
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Gallery Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile menu functionality
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');

            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', function() {
                    mobileMenu.classList.toggle('hidden');
                    const icon = mobileMenuBtn.querySelector('i');
                    if (mobileMenu.classList.contains('hidden')) {
                        if (icon) icon.className = 'fas fa-bars text-xl';
                    } else {
                        if (icon) icon.className = 'fas fa-times text-xl';
                    }
                });

                // Close mobile menu when clicking outside
                document.addEventListener('click', function(event) {
                    const target = event.target;
                    if (!mobileMenuBtn.contains(target) && !mobileMenu.contains(target)) {
                        mobileMenu.classList.add('hidden');
                        const icon = mobileMenuBtn.querySelector('i');
                        if (icon) icon.className = 'fas fa-bars text-xl';
                    }
                });
            }

            // Photo filter functionality
            const filterBtns = document.querySelectorAll('.filter-btn');
            const photoItems = document.querySelectorAll('.photo-item');
            const noPhotosMsg = document.getElementById('no-photos');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const filter = this.getAttribute('data-filter');

                    // Update active button
                    filterBtns.forEach(b => {
                        b.className = b.className.replace(/bg-gradient-to-r from-blue-500 to-violet-500 text-white border-transparent/, 'border-slate-600 text-slate-300 hover:border-blue-400 hover:text-blue-400');
                    });
                    this.className = this.className.replace(/border-slate-600 text-slate-300 hover:border-blue-400 hover:text-blue-400/, 'bg-gradient-to-r from-blue-500 to-violet-500 text-white border-transparent');

                    // Filter photos
                    let visibleCount = 0;
                    photoItems.forEach(item => {
                        const category = item.getAttribute('data-category');
                        if (filter === 'all' || category === filter) {
                            item.style.display = 'block';
                            visibleCount++;
                        } else {
                            item.style.display = 'none';
                        }
                    });

                    // Show/hide no photos message
                    if (visibleCount === 0) {
                        noPhotosMsg?.classList.remove('hidden');
                    } else {
                        noPhotosMsg?.classList.add('hidden');
                    }
                });
            });

            // Trigger fade-in animations
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                    }
                });
            }, { threshold: 0.1 });

            photoItems.forEach(item => {
                observer.observe(item);
            });
        });
    </script>
</Layout>
