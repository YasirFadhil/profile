---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Project from "../components/Projects.astro";

const title = "ysirnf - Projects";
---

<Layout title={title}>
    <Navigation />
    <div class="min-h-screen pt-20">
        <header class="max-w-6xl mx-auto text-center py-12">
            <h1
                class="text-4xl md:text-5xl font-bold mb-2 bg-linear-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >
                Projects
            </h1>
            <p class="text-slate-300 mt-3 max-w-2xl mx-auto">
                A curated collection of projects I've built — from web apps to
                creative work and studies. Click any project to learn more.
            </p>
        </header>

        <main class="max-w-6xl mx-auto px-6 pb-20">
            <Project />
        </main>
    </div>
</Layout>
